# ── Môi trường CHẠY THỬ LOCAL (không commit — đã nằm trong .gitignore qua `.env.*`) ──
# PostgreSQL local trong Docker: docker run -d --name scms_pg_local -e POSTGRES_USER=scms \
#   -e POSTGRES_PASSWORD=scms_local -e POSTGRES_DB=scms_local -p 5440:5432 postgres:15-alpine
# Chạy: npm run dev:local | npm run db:migrate:local | npm run db:seed:local | npm run test:local
#
# dotenv đọc file này THAY cho .env (không bao giờ chạm DB Render / SMTP / Cloudinary thật).
DOTENV_CONFIG_PATH=.env.local
NODE_ENV=development
DATABASE_URL=postgresql://scms:scms_local@localhost:5440/scms_local?schema=public
PORT=8081
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Không gửi mail thật: để trống ⇒ outbox ghi FAILED, test đọc nội dung mail trong DB local.
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Avatar lưu ổ đĩa local, không đẩy Cloudinary.
AVATAR_STORAGE=local
CLOUDINARY_URL=
CLOUDINARY_FOLDER=
# SePay: chế độ mô phỏng, không gọi API SePay thật.
VIETQR_BANK_ID=MBBank
VIETQR_ACCOUNT_NO=0000000000
VIETQR_ACCOUNT_NAME=PULSE LOCAL
VIETQR_PAYMENT_TTL_MINUTES=15
SEPAY_MOCK_MODE=true
SEPAY_WEBHOOK_SECRET=local-webhook-secret
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=
SEPAY_RECONCILE_MIN_SECONDS=5

# ─────────────────────────────────────────────────────────────────────────────
# Bổ sung 25/10/2026 — biến code đang đọc nhưng file chưa khai báo (giá trị = mặc định trong code).
# ─────────────────────────────────────────────────────────────────────────────
SMTP_SECURE=false
BREVO_SENDER_NAME=Pulse Sports Center
# Không gửi mail thật khi chạy local (MAIL_PROVIDER=smtp + SMTP trống ⇒ outbox ghi FAILED, test đọc trong DB).
RESEND_API_KEY=
RESEND_FROM=
LOCATIONS_API_URL=https://provinces.open-api.vn/api
# Mã nhận hàng tại quầy (HMAC) — secret riêng cho DB local.
SHOP_PICKUP_SECRET=0743409014f84f15f9da8e95583efb2c287907afb6d00d28595d4f34a3c0910d
# Tắt rate limit khi chạy e2e cần gọi OTP liên tục (auth-security). Để trống khi chạy bộ shop (case spam ⇒ 429).
RATE_LIMIT_DISABLED=

# SePay — tùy chọn
SEPAY_WEBHOOK_API_KEY=
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact
SEPAY_CODE_PREFIX=SEVQR
SEPAY_CODE_SUFFIX_LENGTH=8
SEPAY_WEBHOOK_MAX_SKEW_SECONDS=300

# Khóa học (Doc/GYM_SCOPE_CHANGES.md §11, §20)
LATE_CANCEL_FEE_PERCENT=30
COURSE_SALE_MAX_PROGRESS_PERCENT=50
COURSE_SALE_MIN_REMAINING_SESSIONS=3

# Cửa hàng (Doc/SHOP_FLOW_DESIGN.md §2.3) — bỏ trống SHOP_HOLD_MINUTES = theo VIETQR_PAYMENT_TTL_MINUTES
SHOP_MAX_PENDING_ORDERS=2
SHOP_PICKUP_DAYS=3
SHOP_PICKUP_MAX_DAYS_AHEAD=7
SHOP_PICKUP_MAX_RESCHEDULES=1
SHOP_PICKUP_RESCHEDULE_MAX_DAYS=3
SHOP_PICKUP_REMINDER_HOURS=24
SHOP_SHIPPING_FEE=15000
SHOP_FREE_SHIPPING_THRESHOLD=500000
SHOP_DELIVERY_PROVINCES=Hồ Chí Minh
SHOP_EXPIRE_LOCK_THRESHOLD=3
SHOP_EXPIRE_LOCK_HOURS=24
SHOP_NOT_PICKED_UP_REFUND_PERCENT=100
SHOP_CASH_MAX_ORDER_VALUE=2000000
SHOP_CASH_MAX_OPEN_ORDERS=1
SHOP_NO_SHOW_WINDOW_DAYS=90
SHOP_NO_SHOW_CASH_LOCK_THRESHOLD=2
SHOP_CASH_LOCK_DAYS=30
SHOP_NO_SHOW_FEE_THRESHOLD=3
SHOP_NO_SHOW_FEE_PERCENT=10
SHOP_STALE_REFUND_DAYS=30
SHOP_AUTO_COMPLETE_DAYS=3
SHOP_PICKUP_MAX_ATTEMPTS=5
SHOP_PICKUP_LOCK_MINUTES=15
