      "/subscriptions": {
        "post": {
          "summary": "Register member to a membership plan",
          "tags": [
            "Subscriptions"
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "memberId",
                    "planId",
                    "paymentMethod"
                  ],
                  "properties": {
                    "memberId": {
                      "type": "string"
                    },
                    "planId": {
                      "type": "string"
                    },
                    "startDate": {
                      "type": "string"
                    },
                    "paymentMethod": {
                      "type": "string",
                      "enum": [
                        "CASH",
                        "BANK_TRANSFER"
                      ]
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "201": {
              "$ref": "#/components/responses/SubscriptionCreated"
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
