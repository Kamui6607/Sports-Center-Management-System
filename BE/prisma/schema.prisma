generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// BaseEntity — field chung của MỌI model (Prisma không hỗ trợ kế thừa model,
// nên mỗi model tự khai báo đủ 3 field dưới đây, ĐÚNG định nghĩa này):
//
//   id        String   @id @default(uuid())
//   createdAt DateTime @default(now())
//   updatedAt DateTime @default(now()) @updatedAt
//
// `@default(now())` của updatedAt giúp INSERT bằng SQL thô ($executeRaw) không lỗi NOT NULL.
// Thêm model mới ⇒ khai báo đủ 3 field + thêm model vào `src/types/base-entity.ts`
// (tsc sẽ báo lỗi nếu thiếu).
// ─────────────────────────────────────────

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum ClassApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ClassType {
  REGULAR
  PREMIUM
}

enum AreaType {
  POOL
  INDOOR
  OUTDOOR
}

enum ScheduleStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

/// Phương án xử lý khi hủy buổi đã có học viên đặt chỗ (BE-20).
enum ScheduleCancelResolution {
  MAKEUP
  REFUND
}

enum EnrollmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  SEPAY
}

/// Trạng thái xử lý một webhook SePay (bảng `SepayWebhookEvent`).
enum SepayWebhookStatus {
  PENDING // Đã claim sepayId, đang xử lý trong transaction (không thấy được nếu transaction rollback)
  PROCESSED // Đã chốt giao dịch (kích hoạt gói)
  DUPLICATE // Webhook lặp (cùng sepayId) hoặc giao dịch đã SUCCESS trước đó
  LATE // Tiền về sau khi giao dịch đã đóng (hết hạn/thất bại) — cần đối soát, KHÔNG kích hoạt
  MISMATCH // Lệch số tiền hoặc số tài khoản — cần đối soát, KHÔNG kích hoạt
  IGNORED // Tiền ra / không khớp mã đơn nào — bỏ qua
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

/// A06: trạng thái CẤP QUYỀN của giao dịch — tách khỏi `status` (trạng thái TIỀN).
/// `REQUIRES_REVIEW` = tiền ĐÃ thu nhưng gói chưa được cấp (cần quản lý xử lý/đối soát).
enum PaymentActivationStatus {
  ACTIVATED
  REQUIRES_REVIEW
}

/// F01: vòng đời bản ghi outbox notification.
enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Kênh giao của một dòng outbox: thông báo trong app hoặc email (Brevo).
enum OutboxChannel {
  IN_APP
  EMAIL
}

// ─────────────────────────────────────────
// AUTH / USER
// ─────────────────────────────────────────

/// Vai trò người dùng (bảng tra cứu). Hệ thống dùng 3 dòng: MEMBER, COACH, MANAGER
/// (tạo sẵn bởi migration `20261005010000_role_table` và `prisma/seed.ts`).
/// Code tra vai trò theo `name` (UNIQUE) — xem `src/utils/roles.ts`.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  users User[]
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  fullName    String
  phone       String?   @unique
  gender      Gender?
  dateOfBirth DateTime?
  avatarUrl   String?
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive    Boolean   @default(true)
  /// Cửa hàng: tạm khóa đặt hàng tới thời điểm này (để đơn hết hạn quá nhiều lần) — null = không khóa.
  checkoutLockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  memberProfile              MemberProfile?
  coachProfile               CoachProfile?
  managerProfile             ManagerProfile?
  refreshTokens              RefreshToken[]
  passwordResetOtp           PasswordResetOtp?
  createdPayments            Payment[]              @relation("PaymentCreatedBy")
  sentMessages               ChatMessage[]          @relation("SentMessages")
  receivedMessages           ChatMessage[]          @relation("ReceivedMessages")
  chatAttachmentsOwned       ChatAttachment[]       @relation("ChatAttachmentOwner")
  chatAttachmentsReceived    ChatAttachment[]       @relation("ChatAttachmentReceiver")
  notifications              Notification[]
  decidedAttendancePenalties AttendancePenalty[]    @relation("AttendancePenaltyDecidedBy")
  createdManualCodes         AttendanceManualCode[] @relation("AttendanceManualCodeCreatedBy")
  createdProducts            Product[]              @relation("ProductCreatedBy")
  productReviews             ProductReview[]        @relation("ProductReviewUser")
  orders                     Order[]                @relation("OrderUser")
  refundsRequested           Refund[]               @relation("RefundRequestedBy")
  refundsProcessed           Refund[]               @relation("RefundProcessedBy")
  cart                       Cart?
  addresses                  UserAddress[]

  @@index([roleId])
}

/// Mã OTP 6 số đặt lại mật khẩu (Mobile). Mỗi user tối đa 1 mã đang hiệu lực — gửi lại ⇒ ghi đè.
/// Chỉ lưu HASH (bcrypt); hết hạn 15 phút; sai quá 5 lần ⇒ mã bị khóa; gửi lại tối thiểu sau 60 giây.
model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────
// PROFILES
// ─────────────────────────────────────────

model MemberProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitnessGoal        String?
  trainingLevel      TrainingLevel?
  trainingPreference String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  enrollments        Enrollment[]
  payments           Payment[]
  attendances        Attendance[]
  trainingPlans      TrainingPlan[]
  feedbacks          CoachFeedback[]
  penalties          AttendancePenalty[]
  manualCodeAttempts AttendanceManualCodeAttempt[]
  refunds            Refund[]
}

enum CoachApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model CoachProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String?
  experienceYears Int?
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  /// Hồ sơ chứng nhận HLV (CV) — xem model Certification.
  certification Certification?
  classes       Class[]
  wallet        CoachWallet?
  trainingPlans TrainingPlan[]
  feedbacks     CoachFeedback[]
}

/// Hồ sơ chứng nhận HLV (CV) để Manager xét duyệt — 1–1 với CoachProfile.
/// Nộp lại CV ⇒ GHI ĐÈ fileUrl, status về PENDING, xóa kết quả duyệt cũ.
/// Duyệt APPROVED ⇒ tài khoản Coach được kích hoạt (User.isActive = true).
model Certification {
  id           String              @id @default(uuid())
  coachId      String              @unique
  coach        CoachProfile        @relation(fields: [coachId], references: [id], onDelete: Cascade)
  /// Đường dẫn file CV (PDF). NULL = hồ sơ được duyệt khi chưa có luồng nộp CV (dữ liệu cũ / seed).
  fileUrl      String?
  status       CoachApprovalStatus @default(PENDING)
  /// Thời điểm nộp CV lần gần nhất.
  submittedAt  DateTime            @default(now())
  /// Lý do Manager từ chối (chỉ có khi status = REJECTED; nộp lại CV thì xóa).
  rejectReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  @@index([status])
}

model ManagerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─────────────────────────────────────────
// MEMBERSHIP
// ─────────────────────────────────────────

// ─────────────────────────────────────────
// ROOMS
// ─────────────────────────────────────────

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  capacity  Int
  location  String?
  areaType  AreaType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  schedules ClassSchedule[]
}

// ─────────────────────────────────────────
// CLASS
// ─────────────────────────────────────────

model Class {
  id          String  @id @default(uuid())
  name        String
  description String?
  /// Mục tiêu của lớp (HLV ghi) để Member xem và tự đánh giá có phù hợp trước khi đăng ký.
  /// Khác MemberProfile.fitnessGoal (mục tiêu của Member, để HLV đọc).
  goal        String?
  /// Môn tập của lớp (Yoga, HIIT, Bơi...). Chuỗi tự do do Coach nhập — KHÔNG còn bảng bộ môn / quan hệ nhiều-nhiều.
  fitness     String

  price       Decimal             @default(0) @db.Decimal(12, 2)
  status      ClassApprovalStatus @default(PENDING)
  /// BE-2: lý do Manager từ chối (xóa khi Coach gửi lại — BE-3).
  rejectReason String?
  /// HLV tạo và phụ trách lớp — mỗi lớp đúng 1 HLV (nhận 85% doanh thu). Chỉ Coach được tạo lớp.
  coachId     String
  coach       CoachProfile        @relation(fields: [coachId], references: [id])
  capacity    Int
  classType   ClassType           @default(REGULAR)
  // Khu vực mà lớp học yêu cầu (POOL | INDOOR | OUTDOOR).
  // Khác với classType (REGULAR | PREMIUM là hạng lớp).
  areaType    AreaType
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  schedules          ClassSchedule[]
  feedbacks          CoachFeedback[]
  penalties          AttendancePenalty[]
  walletTransactions WalletTransaction[]
  payments           Payment[]
  refunds            Refund[]

  @@index([coachId])
}

model ClassSchedule {
  id        String         @id @default(uuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room           @relation(fields: [roomId], references: [id])
  startTime DateTime
  endTime   DateTime
  status    ScheduleStatus @default(SCHEDULED)
  /// BE-20: lý do & phương án khi buổi bị hủy (null nếu chưa hủy / hủy khi chưa ai đặt chỗ).
  cancelReason     String?
  cancelResolution ScheduleCancelResolution?
  /// Buổi DẠY BÙ: trỏ tới buổi bị hủy mà buổi này thay thế (NULL = buổi chính của lớp).
  /// Tiền 1 buổi khi hoàn = tiền lớp ÷ số buổi CHÍNH (không tính buổi bù).
  makeupForId String?        @unique
  makeupFor   ClassSchedule? @relation("ScheduleMakeup", fields: [makeupForId], references: [id], onDelete: SetNull)
  makeup      ClassSchedule? @relation("ScheduleMakeup")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  enrollments Enrollment[]
  attendances Attendance[]
  manualCodes AttendanceManualCode[]
  refunds     Refund[]

  @@index([classId])
  @@index([roomId])
  @@index([startTime, endTime])
}

// ─────────────────────────────────────────
// ENROLLMENT
// ─────────────────────────────────────────

model Enrollment {
  id          String           @id @default(uuid())
  memberId    String
  member      MemberProfile    @relation(fields: [memberId], references: [id])
  /// Giữ chỗ theo TỪNG BUỔI; lớp của buổi lấy qua `schedule.classId` (không lưu trùng classId).
  scheduleId  String
  schedule    ClassSchedule    @relation(fields: [scheduleId], references: [id])
  status      EnrollmentStatus @default(BOOKED)
  bookedAt    DateTime         @default(now())
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@unique([memberId, scheduleId])
  @@index([memberId])
  @@index([scheduleId])
}

// ─────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────

model Payment {
  id                String                   @id @default(uuid())
  /// NULL khi người mua không phải hội viên (HLV mua sản phẩm) — người mua lấy từ Order.userId.
  memberId          String?
  member            MemberProfile?           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  /// Gói hội viên mà giao dịch này muốn mua — cần cho giao dịch ONLINE: Payment PENDING
  /// được tạo TRƯỚC khi có subscription (chỉ tạo subscription khi cổng thanh toán xác nhận SUCCESS).
  amount            Decimal                  @db.Decimal(12, 2)
  method            PaymentMethod
  classId           String?
  class             Class?                   @relation(fields: [classId], references: [id])
  classNameSnapshot String?
  /// Đơn mua sản phẩm mà giao dịch này thanh toán. Một giao dịch chỉ trỏ tới classId HOẶC orderId.
  orderId           String?                  @unique
  order             Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status            PaymentStatus            @default(PENDING)
  /// Mã đơn/mã thanh toán duy nhất — với giao dịch SePay đây là mã SePay bóc tách từ nội dung CK.
  transactionCode   String?                  @unique
  /// Cổng thanh toán online (VD "SEPAY"). NULL cho giao dịch tại quầy (CASH/BANK_TRANSFER).
  gateway           String?
  /// Mã giao dịch phía ngân hàng/SePay (referenceCode) để đối soát.
  gatewayTransId    String?
  /// Metadata thô của webhook SePay (payload đầy đủ + thông tin QR) để audit & tra soát.
  gatewayPayload    Json?
  note              String?
  paidAt            DateTime?
  /// A07 — snapshot điều khoản gói TẠI THỜI ĐIỂM TẠO ĐƠN: chốt tiền theo đúng offer đã bán,
  /// không đọc cấu hình plan hiện tại (giá/duration/tier/quota có thể bị sửa trong lúc chờ CK).
  /// A06 — trạng thái CẤP QUYỀN (tách khỏi `status` là trạng thái TIỀN). NULL = giao dịch
  /// chưa chốt/không cần theo dõi (dữ liệu cũ).
  activationStatus  PaymentActivationStatus?
  /// Lý do cần đối soát (VD: PLAN_MISSING / thông điệp chặn kích hoạt) — null khi đã xử lý.
  reviewReason      String?
  reviewedAt        DateTime?
  reviewedById      String?
  createdById       String?
  createdBy         User?                    @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt

  sepayWebhookEvents SepayWebhookEvent[]
  bankTransactions   SepayBankTransaction[]
  refunds            Refund[]
  walletTransactions WalletTransaction[]

  @@index([memberId])
  @@index([status])
  @@index([createdAt])
  @@index([gateway, status])
  @@index([activationStatus])
}

/// A14 — Ledger giao dịch ngân hàng (SePay): một movement chỉ được ghi nhận & phân bổ MỘT LẦN,
/// dùng chung cho webhook và đối soát API ⇒ idempotency xuyên hai kênh.
model SepayBankTransaction {
  id               String    @id @default(uuid())
  /// Danh tính chuẩn hoá của movement: `ref:<referenceCode>` khi có (chung cho webhook + API),
  /// ngược lại `sepay:<payload.id>` (webhook/mock) hoặc `api:<uuid>` (đối soát API).
  externalId       String    @unique
  sepayId          Int?      @unique
  apiTransactionId String?   @unique
  referenceCode    String?
  gateway          String?
  accountNumber    String?
  transferType     String
  amount           Decimal   @db.Decimal(12, 2)
  content          String?
  /// Mã đơn bóc tách được tại thời điểm ghi ledger.
  code             String?
  payload          Json?
  /// MỘT movement chỉ được cấp quyền cho ĐÚNG MỘT payment (UNIQUE) — chống cấp gói 2 lần.
  paymentId        String?   @unique
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  allocatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([createdAt])
  @@index([referenceCode])
}

/// F01 — Transactional outbox cho notification: ghi TRONG transaction nghiệp vụ, gửi SAU commit,
/// retry khi lỗi ⇒ không mất thông báo khi transaction rollback hoặc process chết giữa chừng.
model NotificationOutbox {
  id          String       @id @default(uuid())
  userId      String
  /// IN_APP ⇒ tạo Notification; EMAIL ⇒ gửi qua Brevo (title = subject, body = HTML, email = người nhận).
  channel     OutboxChannel @default(IN_APP)
  email       String?
  type        String
  title       String
  body        String
  reason      String?
  metadata    Json?
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  sentAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([status, availableAt])
  @@index([userId])
}

/// Log webhook nhận từ SePay — `sepayId` UNIQUE chống xử lý trùng khi SePay retry/replay webhook.
/// Một giao dịch chuyển khoản chỉ được kích hoạt gói ĐÚNG MỘT LẦN (claim + chốt trong cùng transaction).
model SepayWebhookEvent {
  id        String             @id @default(uuid())
  /// `payload.id` của SePay — không đổi qua mọi lần retry/replay.
  sepayId   Int                @unique
  paymentId String?
  payment   Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status    SepayWebhookStatus @default(PENDING)
  /// Lý do trạng thái cuối (VD ORDER_NOT_FOUND, AMOUNT_MISMATCH, LATE_RESULT…).
  reason    String?
  payload   Json
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now()) @updatedAt

  @@index([paymentId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// CHAT MESSAGE
// ─────────────────────────────────────────

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?
  receiver   User?    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String?
  fileUrl    String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  attachment ChatAttachment?

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

/// D03 — Metadata của file chat (KHÔNG phục vụ tĩnh công khai):
/// quyết định AI được tải file (owner / receiver / MANAGER; phòng chung = mọi user đăng nhập)
/// và cho phép dọn file khi request bị từ chối.
model ChatAttachment {
  id         String       @id @default(uuid())
  ownerId    String
  owner      User         @relation("ChatAttachmentOwner", fields: [ownerId], references: [id])
  /// Người nhận (NULL = phòng chung).
  receiverId String?
  receiver   User?        @relation("ChatAttachmentReceiver", fields: [receiverId], references: [id])
  messageId  String?      @unique
  message    ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  /// Tên file trên disk do SERVER sinh (không dùng tên gốc của client).
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  @@index([ownerId])
  @@index([receiverId])
}

// ─────────────────────────────────────────
// TRAINING & ATTENDANCE (FLOW 4)
// ─────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id         String           @id @default(uuid())
  scheduleId String
  schedule   ClassSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  memberId   String
  member     MemberProfile    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status     AttendanceStatus @default(PRESENT)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  @@unique([scheduleId, memberId])
  @@index([scheduleId])
  @@index([memberId])
}

/// Mã dự phòng nhập tay cho Member không quét được QR (camera/điện thoại lỗi).
/// Sinh cùng lượt với QR ở POST /attendance/generate-qr; TTL ngắn (90s) và mã cũ của cùng
/// buổi học bị thu hồi khi mã mới được cấp (mỗi thời điểm chỉ có 1 mã hợp lệ / schedule).
/// `attempts` đếm số lần nhập SAI vào chính mã này; vượt ngưỡng → mã bị vô hiệu (revokedAt).
model AttendanceManualCode {
  id         String        @id @default(uuid())
  code       String        @unique
  scheduleId String
  schedule   ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  /// userId (COACH/MANAGER) đã cấp mã — audit.
  createdBy  String
  creator    User          @relation("AttendanceManualCodeCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  attempts   Int           @default(0)
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt

  attemptLogs AttendanceManualCodeAttempt[]

  @@index([scheduleId, expiresAt])
  @@index([createdBy])
}

/// Log mọi lần thử nhập mã dự phòng (kể cả sai/hết hạn) — dùng cho rate-limit theo member + audit.
model AttendanceManualCodeAttempt {
  id        String                @id @default(uuid())
  memberId  String
  member    MemberProfile         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  codeId    String?
  code      AttendanceManualCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)
  success   Boolean
  createdAt DateTime              @default(now())
  updatedAt DateTime              @default(now()) @updatedAt

  @@index([memberId, createdAt])
}

enum AttendancePenaltyStatus {
  /// Reserved: hiện KHÔNG có flow nào persist PENDING (preview là read-only, apply tạo thẳng APPLIED).
  /// Giữ lại cho luồng "đề xuất chờ duyệt" trong tương lai; không tạo record PENDING giả.
  PENDING
  APPLIED
  REVOKED
  EXPIRED
}

/// Lịch sử hình phạt chuyên cần theo (member × class): thu hồi slot tương lai + chặn đặt lại.
model AttendancePenalty {
  id                    String                  @id @default(uuid())
  memberId              String
  member                MemberProfile           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classId               String
  class                 Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  reason                String
  attendanceRate        Float
  sampleSize            Int
  releasedCount         Int                     @default(0)
  releasedEnrollmentIds Json?
  blockedUntil          DateTime?
  status                AttendancePenaltyStatus @default(PENDING)
  decidedBy             String?
  decider               User?                   @relation("AttendancePenaltyDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)
  decidedAt             DateTime?
  appealReason          String?
  appealedAt            DateTime?
  revokedBy             String?
  revokedAt             DateTime?
  revokedReason         String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt

  @@index([memberId, classId])
  @@index([status, blockedUntil])
}

model TrainingPlan {
  id          String        @id @default(uuid())
  memberId    String
  member      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  coachId     String
  coach       CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  results TrainingResult[]

  @@index([memberId])
  @@index([coachId])
}

model TrainingResult {
  id        String       @id @default(uuid())
  planId    String
  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  date      DateTime
  metrics   Json? // Custom metrics like weight, body fat
  coachNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@index([planId])
}

// ─────────────────────────────────────────
// COACH FEEDBACK
// ─────────────────────────────────────────

model CoachFeedback {
  id          String        @id @default(uuid())
  coachId     String
  coach       CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  memberId    String
  member      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classId     String?
  class       Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  rating      Int // 1-5 sao
  comment     String?
  isAnonymous Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@unique([coachId, memberId, classId])
  @@index([coachId])
  @@index([memberId])
}

// ─────────────────────────────────────────
// NOTIFICATIONS (BR-24)
// ─────────────────────────────────────────

enum NotificationType {
  // ── Tài khoản ──
  MEMBER_REGISTERED // Chào mừng hội viên mới đăng ký
  // ── Chat ──
  CHAT_MESSAGE // Nhận tin nhắn mới
  // ── Gói tập ──
  // ── Lịch học ──
  UPCOMING_CLASS // Nhắc lớp sắp học (24h trước)
  SCHEDULE_CANCELLED // Lịch học bị hủy
  SCHEDULE_UPDATED // Lịch học được dời giờ
  // ── Đặt lớp ──
  ENROLLMENT_CONFIRMED // Đặt lớp thành công
  ENROLLMENT_CANCELLED // Hủy đặt lớp
  // ── Kế hoạch tập luyện ──
  TRAINING_PLAN_ASSIGNED // HLV giao kế hoạch tập mới
  // ── Lớp học ──
  CLASS_APPROVED
  CLASS_REJECTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  NEW_CLASS // Lớp học mới được mở
  COACH_CHANGED // Đổi HLV cho lớp
  // ── Chuyên cần (Attendance) ──
  ATTENDANCE_WARNING // Cảnh báo chuyên cần dưới 80%
  ATTENDANCE_PENALTY // Hình phạt chuyên cần: thu hồi slot + chặn đặt lại
  ATTENDANCE_PENALTY_REVOKED // Hình phạt chuyên cần được gỡ
  SCHEDULE_ROOM_CHANGED // Lịch học đổi phòng (bulk transfer Room hư)
  // ── Thanh toán ──
  PAYMENT_SUCCESS // Thanh toán thành công
  PAYMENT_REFUNDED // Hoàn tiền
  // ── Cửa hàng ──
  ORDER_UPDATED // Đơn hàng đổi trạng thái (đã thanh toán, sẵn sàng nhận, đang giao, hết hạn…)
  // ── Chung ──
  GENERAL
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  reason    String? // Lý do (dùng cho hủy gói, hủy lịch…)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json? // e.g. { scheduleId, classId, subscriptionId, senderId }
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// COACH WALLET
// ─────────────────────────────────────────

model CoachWallet {
  id        String       @id @default(uuid())
  coachId   String       @unique
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  balance   Decimal      @default(0) @db.Decimal(12, 2)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  transactions WalletTransaction[]
  refunds      Refund[]
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  /// Trừ ví HLV khi hoàn tiền cho hội viên (hủy khóa / hủy buổi không dạy bù).
  REFUND_DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  FAILED
}

model WalletTransaction {
  id        String            @id @default(uuid())
  walletId  String
  wallet    CoachWallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Decimal           @db.Decimal(12, 2)
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  classId   String?
  class     Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  /// Giao dịch thanh toán gốc (DEPOSIT: tiền lớp được cộng vào ví; REFUND_DEBIT: tiền hoàn bị trừ).
  paymentId String?
  payment   Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  bankInfo  Json?
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  @@index([walletId])
  @@index([status])
  @@index([paymentId])
}

// ─────────────────────────────────────────
// HOÀN TIỀN (REFUND)
// ─────────────────────────────────────────

enum RefundReason {
  MEMBER_CANCEL_COURSE // Hội viên hủy khóa trước khai giảng ≥ 24h — hoàn phần còn lại của giao dịch
  SESSION_CANCELLED // Buổi học bị hủy và chọn hoàn tiền (không dạy bù) — hoàn tiền 1 buổi
  ORDER_CANCELLED // Đơn hàng đã thanh toán bị hủy (khách yêu cầu / trung tâm hủy) — hoàn toàn bộ
  ORDER_NOT_PICKED_UP // Khách không đến lấy hàng đúng hạn — hoàn theo chính sách (SHOP_NOT_PICKED_UP_REFUND_PERCENT)
  ORDER_LATE_PAYMENT // Tiền về sau khi đơn đã hết hạn/hủy — không khôi phục đơn, hoàn lại tiền
}

enum RefundStatus {
  PENDING // Chờ Manager chuyển khoản tay rồi duyệt
  COMPLETED // Đã hoàn: ví HLV đã bị trừ, hội viên đã nhận tiền
  REJECTED // Manager từ chối (kèm lý do)
}

/// Yêu cầu hoàn tiền cho hội viên. SePay không có API hoàn ⇒ Manager chuyển khoản tay rồi duyệt;
/// lúc duyệt mới trừ ví HLV (`coachDebitAmount`) và (nếu hủy khóa) đổi Payment sang REFUNDED.
model Refund {
  id               String        @id @default(uuid())
  paymentId        String
  payment          Payment       @relation(fields: [paymentId], references: [id])
  /// Hội viên nhận hoàn (null khi người mua đơn hàng là HLV — người nhận lấy từ `order.userId`).
  memberId         String?
  member           MemberProfile? @relation(fields: [memberId], references: [id], onDelete: Restrict)
  /// Đơn hàng được hoàn (lý do ORDER_*); null với hoàn tiền khóa học.
  orderId          String?
  order            Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  classId          String?
  class            Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  /// Buổi bị hủy (chỉ với SESSION_CANCELLED).
  scheduleId       String?
  schedule         ClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  reason           RefundReason
  /// Số tiền hoàn cho hội viên.
  amount           Decimal       @db.Decimal(12, 2)
  /// Phần trừ vào ví HLV khi duyệt (tỷ lệ theo số tiền HLV đã được cộng từ giao dịch gốc).
  coachDebitAmount Decimal       @default(0) @db.Decimal(12, 2)
  coachWalletId    String?
  coachWallet      CoachWallet?  @relation(fields: [coachWalletId], references: [id], onDelete: SetNull)
  note             String?
  /// L8: ghi chú của Member khi gửi yêu cầu (cột `note` cũ giữ cho Web).
  memberNote       String?
  /// L8: ghi chú của Manager khi duyệt (VD mã giao dịch chuyển khoản hoàn tiền).
  managerNote      String?
  status           RefundStatus  @default(PENDING)
  requestedById    String?
  requestedBy      User?         @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  processedById    String?
  processedBy      User?         @relation("RefundProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt      DateTime?
  rejectReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  /// Một buổi bị hủy chỉ hoàn MỘT lần cho mỗi giao dịch.
  @@unique([paymentId, scheduleId])
  @@index([status])
  @@index([memberId])
  @@index([coachWalletId, status])
  @@index([orderId])
}

// ─────────────────────────────────────────
// CỬA HÀNG (Product, Cart, Order…) — xem Doc/SHOP_FLOW_DESIGN.md
// ─────────────────────────────────────────

model Product {
  id            String          @id @default(uuid())
  name          String
  description   String
  price         Decimal         @db.Decimal(12, 2)
  /// Tồn THỰC TẾ trên kệ. Có thể bán = `stockQuantity − reservedStock` (API trả `availableStock`).
  stockQuantity Int             @default(0)
  /// Số lượng đang GIỮ cho đơn chờ thanh toán (PENDING_PAYMENT) — nhả khi hết hạn/hủy, trừ hẳn khi PAID.
  reservedStock Int             @default(0)
  /// BE-6: ảnh sản phẩm (URL tuyệt đối hoặc đường dẫn tĩnh).
  imageUrl      String?
  /// Bộ ảnh phụ (ảnh đầu tiên trùng `imageUrl` nếu có).
  imageUrls     String[]        @default([])
  /// Số lượng tối đa của sản phẩm trong MỘT đơn.
  maxPerOrder   Int             @default(10)
  /// Số lượng tối đa MỘT người được đặt trong một ngày (giờ VN, không tính đơn hết hạn/đã hủy).
  maxPerDay     Int             @default(20)
  /// Ngưỡng cảnh báo sắp hết hàng (theo số có thể bán).
  lowStockThreshold Int         @default(5)
  rating        Decimal         @default(0) @db.Decimal(3, 2)
  reviewCount   Int             @default(0)
  isActive      Boolean         @default(true)
  createdById   String
  createdBy     User            @relation("ProductCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  reviews       ProductReview[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  inventoryTransactions InventoryTransaction[]
}

/// Đánh giá sản phẩm: chỉ cho dòng đơn (OrderItem) thuộc đơn COMPLETED, mỗi dòng tối đa 1 đánh giá.
/// Đánh giá cũ (trước luồng mới) có `orderItemId = null`.
model ProductReview {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("ProductReviewUser", fields: [userId], references: [id], onDelete: Cascade)
  orderItemId  String?    @unique
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  rating       Int
  comment      String?
  /// Manager ẩn đánh giá (không hiển thị công khai, không tính điểm trung bình).
  isHidden     Boolean    @default(false)
  hiddenReason String?
  hiddenById   String?
  hiddenAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@index([productId, isHidden])
  @@index([userId])
}

/// Giỏ hàng lưu ở server (một giỏ / người). Giỏ KHÔNG giữ tồn kho.
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  items     CartItem[]
}

model CartItem {
  id                String   @id @default(uuid())
  cartId            String
  cart              Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int
  /// Giá lúc thêm vào giỏ — khác giá hiện tại ⇒ cảnh báo PRICE_CHANGED (giá thanh toán luôn do server tính).
  unitPriceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

/// Sổ địa chỉ giao hàng của người dùng (đơn DELIVERY lưu SNAPSHOT địa chỉ, không trỏ bảng này).
model UserAddress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  province      String
  district      String
  ward          String?
  street        String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([userId])
}

enum FulfillmentType {
  PICKUP // Nhận tại quầy trung tâm (mã nhận hàng)
  DELIVERY // Giao tận nơi (mã vận đơn)
}

model Order {
  id          String      @id @default(uuid())
  /// Mã đơn dễ đọc, duy nhất (VD DH241011-7KQ3XM) — KHÁC mã chuyển khoản SePay (`Payment.transactionCode`).
  code        String      @unique
  userId      String
  user        User        @relation("OrderUser", fields: [userId], references: [id])
  fulfillmentType FulfillmentType @default(PICKUP)
  /// Tạm tính = Σ `OrderItem.totalAmount` (server tính).
  subtotal    Decimal     @db.Decimal(12, 2)
  shippingFee Decimal     @default(0) @db.Decimal(12, 2)
  /// Tổng phải trả = subtotal + shippingFee — cũng là số tiền của Payment / mã QR.
  totalPrice  Decimal     @db.Decimal(12, 2)
  status      OrderStatus @default(PENDING_PAYMENT)
  /// Snapshot người nhận (cả PICKUP — đối chiếu 4 số cuối SĐT khi nhận hàng).
  recipientName    String?
  recipientPhone   String?
  /// Snapshot địa chỉ giao (DELIVERY).
  shippingAddress  String?
  shippingProvince String?
  note        String?
  /// Hạn chuyển khoản; quá hạn ⇒ job chuyển EXPIRED + nhả hàng.
  paymentExpiresAt DateTime?
  /// Mã nhận hàng (PICKUP, sinh khi READY_FOR_PICKUP): chỉ lưu SHA-256; mã hiển thị = HMAC(secret, id:nonce).
  pickupCodeHash       String?  @unique
  pickupCodeNonce      String?
  pickupDeadline       DateTime?
  pickupFailedAttempts Int      @default(0)
  pickupLockedUntil    DateTime?
  trackingCode String?
  carrier      String?
  /// BE-21: lý do đơn bị hủy (null khi chưa hủy).
  cancelReason OrderCancelReason?
  cancelNote   String?
  cancelledById String?
  /// Chống tạo đơn trùng (header Idempotency-Key) — `idempotencyHash` = hash nội dung request.
  idempotencyKey  String?
  idempotencyHash String?
  paidAt        DateTime?
  processingAt  DateTime?
  readyAt       DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  expiredAt     DateTime?
  notPickedUpAt DateTime?
  refundedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  /// Các dòng hàng của đơn (một đơn có thể mua nhiều sản phẩm).
  items       OrderItem[]
  /// Giao dịch thanh toán của đơn (SePay). PENDING = đang giữ hàng chờ chuyển khoản.
  payment     Payment?
  history     OrderStatusHistory[]
  refunds     Refund[]
  inventoryTransactions InventoryTransaction[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([status, paymentExpiresAt])
  @@index([status, pickupDeadline])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  /// Snapshot tên/ảnh sản phẩm lúc đặt.
  productName     String?
  productImageUrl String?
  quantity    Int
  /// Đơn giá tại thời điểm đặt (snapshot — đổi giá sản phẩm sau này không ảnh hưởng đơn cũ).
  unitPrice   Decimal  @db.Decimal(12, 2)
  /// Thành tiền của dòng = quantity × unitPrice.
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  review      ProductReview?

  @@unique([orderId, productId])
  @@index([productId])
}

/// Lịch sử chuyển trạng thái đơn (actorId null = hệ thống: webhook, job).
model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  reason     String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  @@index([orderId, createdAt])
}

enum InventoryTransactionType {
  IN // Nhập hàng (+stock)
  RESERVE // Giữ hàng khi tạo đơn (+reserved)
  RELEASE // Nhả hàng khi đơn hết hạn/hủy trước khi thanh toán (−reserved)
  SALE // Thanh toán thành công: hàng thuộc khách (−stock, −reserved)
  RETURN // Hoàn tiền đơn đã thanh toán mà hàng còn ở trung tâm (+stock)
  ADJUST // Điều chỉnh kiểm kê/hư hỏng (±stock)
}

/// Nhật ký kho bất biến — mọi thay đổi `stockQuantity` / `reservedStock` đều có một dòng.
model InventoryTransaction {
  id            String                   @id @default(uuid())
  productId     String
  product       Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          InventoryTransactionType
  /// Số lượng (dương); riêng ADJUST có thể âm.
  quantity      Int
  stockAfter    Int
  reservedAfter Int
  orderId       String?
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorId       String?
  note          String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @default(now()) @updatedAt

  @@index([productId, createdAt])
  @@index([orderId])
}

/// Ai/điều gì hủy đơn: người mua, hết hạn chờ chuyển khoản, hay Manager (BE-21).
enum OrderCancelReason {
  BUYER
  EXPIRED
  MANAGER
}

/// Xem máy trạng thái ở Doc/SHOP_FLOW_DESIGN.md §3.
enum OrderStatus {
  PENDING_PAYMENT
