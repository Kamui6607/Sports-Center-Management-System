generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  MEMBER
  COACH
  STAFF
  MANAGER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MemberTier {
  FREE
  MEMBERSHIP
  PREMIUM
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ClassType {
  REGULAR
  PREMIUM
}

enum ScheduleStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum EnrollmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

// ─────────────────────────────────────────
// AUTH / USER
// ─────────────────────────────────────────

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  fullName    String
  phone       String?   @unique
  gender      Gender?
  dateOfBirth DateTime?
  role        UserRole  @default(MEMBER)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberProfile  MemberProfile?
  coachProfile   CoachProfile?
  managerProfile ManagerProfile?
  refreshTokens  RefreshToken[]
  createdPayments Payment[]      @relation("PaymentCreatedBy")
  sentMessages    ChatMessage[]  @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  notifications  Notification[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────
// PROFILES
// ─────────────────────────────────────────

model MemberProfile {
  id                 String        @id @default(uuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitnessGoal        String?
  trainingLevel      TrainingLevel?
  trainingPreference String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  subscriptions MembershipSubscription[]
  enrollments   Enrollment[]
  payments      Payment[]
  invoices      Invoice[]
  attendances   Attendance[]
  trainingPlans TrainingPlan[]
  feedbacks     CoachFeedback[]
}

model CoachProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String?
  experienceYears Int?
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classes ClassMember[]
  trainingPlans TrainingPlan[]
  feedbacks CoachFeedback[]
}

model ManagerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// MEMBERSHIP
// ─────────────────────────────────────────

model MembershipPlan {
  id           String     @id @default(uuid())
  name         String
  description  String?
  price        Decimal    @db.Decimal(12, 2)
  durationDays Int
  tier         MemberTier // MEMBERSHIP or PREMIUM
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subscriptions MembershipSubscription[]
}

model MembershipSubscription {
  id             String           @id @default(uuid())
  memberId       String
  member         MemberProfile    @relation(fields: [memberId], references: [id])
  planId         String
  plan           MembershipPlan   @relation(fields: [planId], references: [id])
  tier           MemberTier       // copied from plan at time of subscription
  startDate      DateTime
  endDate        DateTime
  status         MembershipStatus @default(ACTIVE)
  // BR-15: Suspension tracking
  suspendedAt    DateTime?        // When suspension started
  remainingDays  Int?             // Days remaining when suspended (for resume logic)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  payments Payment[]

  @@index([memberId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

// ─────────────────────────────────────────
// SPORTS & ROOMS
// ─────────────────────────────────────────

model Sport {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes Class[]
}

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  capacity  Int
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules ClassSchedule[]
}

// ─────────────────────────────────────────
// CLASS
// ─────────────────────────────────────────

model Class {
  id          String    @id @default(uuid())
  name        String
  description String?
  
  // Many-to-Many with Sport
  sports      Sport[]

  capacity    Int
  classType   ClassType @default(REGULAR)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  coaches     ClassMember[]
  schedules   ClassSchedule[]
  enrollments Enrollment[]
  feedbacks   CoachFeedback[]
}

// Coach assignment to class (many-to-many)
model ClassMember {
  id        String       @id @default(uuid())
  classId   String
  class     Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id])
  isPrimary Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@unique([classId, coachId])
  @@index([classId])
  @@index([coachId])
}

model ClassSchedule {
  id        String         @id @default(uuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room           @relation(fields: [roomId], references: [id])
  startTime DateTime
  endTime   DateTime
  status    ScheduleStatus @default(SCHEDULED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  enrollments Enrollment[]
  attendances Attendance[]

  @@index([classId])
  @@index([roomId])
  @@index([startTime, endTime])
}

// ─────────────────────────────────────────
// ENROLLMENT
// ─────────────────────────────────────────

model Enrollment {
  id          String           @id @default(uuid())
  memberId    String
  member      MemberProfile    @relation(fields: [memberId], references: [id])
  classId     String
  class       Class            @relation(fields: [classId], references: [id])
  scheduleId  String
  schedule    ClassSchedule    @relation(fields: [scheduleId], references: [id])
  status      EnrollmentStatus @default(BOOKED)
  bookedAt    DateTime         @default(now())
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([memberId, scheduleId])
  @@index([memberId])
  @@index([scheduleId])
  @@index([classId])
}

// ─────────────────────────────────────────
// PAYMENT & INVOICE
// ─────────────────────────────────────────

model Payment {
  id              String                  @id @default(uuid())
  memberId        String
  member          MemberProfile           @relation(fields: [memberId], references: [id])
  subscriptionId  String?
  subscription    MembershipSubscription? @relation(fields: [subscriptionId], references: [id])
  amount          Decimal                 @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus           @default(PENDING)
  transactionCode String?                 @unique
  note            String?
  paidAt          DateTime?
  createdById     String?
  createdBy       User?                   @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  invoice Invoice?

  @@index([memberId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  memberId      String
  member        MemberProfile @relation(fields: [memberId], references: [id])
  paymentId     String        @unique
  payment       Payment       @relation(fields: [paymentId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  // BR-25: Snapshot fields — immutable record of who paid for what
  memberName    String?       // Copied from user.fullName at time of issue
  planName      String?       // Copied from plan.name at time of issue
  planTier      String?       // Copied from plan.tier at time of issue
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([memberId])
  @@index([issuedAt])
}

// ─────────────────────────────────────────
// CHAT MESSAGE
// ─────────────────────────────────────────

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?
  receiver   User?    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String?
  fileUrl    String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// TRAINING & ATTENDANCE (FLOW 4)
// ─────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id          String           @id @default(uuid())
  scheduleId  String
  schedule    ClassSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  memberId    String
  member      MemberProfile    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status      AttendanceStatus @default(PRESENT)
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([scheduleId, memberId])
  @@index([scheduleId])
  @@index([memberId])
}

model TrainingPlan {
  id          String           @id @default(uuid())
  memberId    String
  member      MemberProfile    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  coachId     String
  coach       CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  results     TrainingResult[]

  @@index([memberId])
  @@index([coachId])
}

model TrainingResult {
  id          String        @id @default(uuid())
  planId      String
  plan        TrainingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  date        DateTime
  metrics     Json?         // Custom metrics like weight, body fat
  coachNote   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([planId])
}

// ─────────────────────────────────────────
// COACH FEEDBACK
// ─────────────────────────────────────────

model CoachFeedback {
  id         String        @id @default(uuid())
  coachId    String
  coach      CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  memberId   String
  member     MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classId    String?
  class      Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  rating     Int           // 1-5 sao
  comment    String?
  isAnonymous Boolean      @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([coachId, memberId, classId])
  @@index([coachId])
  @@index([memberId])
}

// ─────────────────────────────────────────
// NOTIFICATIONS (BR-24)
// ─────────────────────────────────────────

enum NotificationType {
  // ── Tài khoản ──
  MEMBER_REGISTERED       // Chào mừng hội viên mới đăng ký
  // ── Chat ──
  CHAT_MESSAGE            // Nhận tin nhắn mới
  // ── Gói tập ──
  SUBSCRIPTION_EXPIRING   // Gói sắp hết hạn (5 ngày trước)
  SUBSCRIPTION_EXPIRED    // Gói đã hết hạn
  SUBSCRIPTION_CANCELLED  // Gói bị hủy (kèm lý do)
  // ── Lịch học ──
  UPCOMING_CLASS          // Nhắc lớp sắp học (24h trước)
  SCHEDULE_CANCELLED      // Lịch học bị hủy
  SCHEDULE_UPDATED        // Lịch học được dời giờ
  // ── Đặt lớp ──
  ENROLLMENT_CONFIRMED    // Đặt lớp thành công
  ENROLLMENT_CANCELLED    // Hủy đặt lớp
  // ── Kế hoạch tập luyện ──
  TRAINING_PLAN_ASSIGNED  // HLV giao kế hoạch tập mới
  // ── Lớp học ──
  NEW_CLASS               // Lớp học mới được mở
  COACH_CHANGED           // Đổi HLV cho lớp
  // ── Thanh toán ──
  PAYMENT_SUCCESS         // Thanh toán thành công
  PAYMENT_REFUNDED        // Hoàn tiền
  // ── Chung ──
  GENERAL
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  reason     String?          // Lý do (dùng cho hủy gói, hủy lịch…)
  isRead     Boolean          @default(false)
  readAt     DateTime?
  metadata   Json?            // e.g. { scheduleId, classId, subscriptionId, senderId }
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
