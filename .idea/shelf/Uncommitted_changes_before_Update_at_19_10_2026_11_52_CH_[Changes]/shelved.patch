+        reason: data.reason.trim(),
+        metadata: {
+          scheduleId: id,
+          classId: s.classId,
+          previousStartTime: existing.startTime,
+          startTime: s.startTime,
+          endTime: s.endTime,
+          conflictWith: clash ?? null,
+        },
+      }
