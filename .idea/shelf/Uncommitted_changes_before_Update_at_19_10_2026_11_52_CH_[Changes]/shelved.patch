+      where: { coachId: profile.id, status: { in: ["APPROVED", "COMPLETED"] } },
+      select: {
+        id: true,
+        name: true,
+        price: true,
+        status: true,
+        isActive: true,
+        classType: true,
+        goalTags: true,
+        targetLevel: true,
+        startDate: true,
