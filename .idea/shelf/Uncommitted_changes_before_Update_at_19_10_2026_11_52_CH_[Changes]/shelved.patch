    }\r\n        }\r\n      }\r\n    },\r\n    \"/feedbacks/{id}/manager\": {\r\n      \"delete\": {\r\n        \"summary\": \"Manager xóa feedback vi phạm\",\r\n        \"tags\": [\r\n          \"Feedbacks\"\r\n        ],\r\n        \"security\": [\r\n          {\r\n            \"BearerAuth\": []\r\n          }\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"path\",\r\n            \"name\": \"id\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            },\r\n            \"description\": \"Feedback ID\"\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"Xóa thành công\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"type\": \"object\"\r\n                },\r\n                \"example\": {\r\n                  \"success\": true,\r\n                  \"data\": {\r\n                    \"message\": \"Feedback đã được xóa bởi quản lý.\"\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"401\": {\r\n            \"$ref\": \"#/components/responses/Unauthorized\"\r\n          },\r\n          \"403\": {\r\n            \"$ref\": \"#/components/responses/Forbidden\"\r\n          },\r\n          \"404\": {\r\n            \"$ref\": \"#/components/responses/NotFound\"\r\n          },\r\n          \"500\": {\r\n            \"$ref\": \"#/components/responses/ServerError\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/enrollments\": {\r\n      \"post\": {\r\n        \"summary\": \"Book a class (Member books own class; Staff/Manager book for a member)\",\r\n        \"description\": \"**Business Rules (Chốt chặn nghiệp vụ):**\\n- Membership must be ACTIVE at booking time.\\n- Membership `endDate` must be ≥ `schedule.startTime` — cannot book a class that happens after your plan expires.\\n- PREMIUM class requires PREMIUM tier.\\n- **Concurrent-class quota**: số Class KHÁC NHAU đang giữ (Enrollment `BOOKED` ở buổi `SCHEDULED` chưa bắt đầu)\\n  không được vượt `MembershipPlan.maxConcurrentClasses` của gói đang ACTIVE. Class đã giữ không tiêu thêm quota.\\n  Vượt quota → **403 `CONCURRENT_CLASS_LIMIT_REACHED`** kèm `tier`/`limit`/`used`/`remaining`.\\n  Member gói FREE có `limit = 0` nên mọi booking Class mới đều bị 403 quota (FE nên gợi ý nâng cấp gói).\\n  Xem chi tiết cách tính ở `GET /enrollments/my/quota`.\\n- No double-booking the same schedule.\\n- No two schedules with overlapping time.\\n- Class capacity must not be exceeded.\\n\",\r\n        \"tags\": [\r\n          \"Enrollments\"\r\n        ],\r\n        \"security\": [\r\n          {\r\n            \"BearerAuth\": []\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"required\": true,\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"type\": \"object\",\r\n                \"required\": [\r\n                  \"scheduleId\"\r\n                ],\r\n                \"properties\": {\r\n                  \"scheduleId\": {\r\n                    \"type\": \"string\",\r\n                    \"format\": \"uuid\"\r\n                  },\r\n                  \"memberId\": {\r\n                    \"type\": \"string\",\r\n                    \"format\": \"uuid\",\r\n                    \"description\": \"Required when booked by Staff/Manager\"\r\n                  }\r\n                }\r\n              },\r\n              \"example\": {\r\n                \"scheduleId\": \"a1b2c3d4-0000-0000-0000-000000000001\"\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"responses\": {\r\n          \"201\": {\r\n            \"$ref\": \"#/components/responses/EnrollmentCreated\"\r\n          },\r\n          \"400\": {\r\n            \"$ref\": \"#/components/responses/BadRequest\"\r\n          },\r\n          \"401\": {\r\n            \"$ref\": \"#/components/responses/Unauthorized\"\r\n          },\r\n          \"403\": {\r\n            \"description\": \"Forbidden — one of:\\n- No active membership\\n- Membership expires before class date\\n- PREMIUM class requires PREMIUM plan\\n- Concurrent-class quota exceeded (`MembershipPlan.maxConcurrentClasses`)\\n- Member đang bị hình phạt chuyên cần ở Class này\\n\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"type\": \"object\"\r\n                },\r\n                \"examples\": {\r\n                  \"no_membership\": {\r\n                    \"summary\": \"No active membership\",\r\n                    \"value\": {\r\n                      \"success\": false,\r\n                      \"message\": \"Bạn không có gói tập đang hoạt động. Vui lòng mua gói để đặt lịch.\"\r\n                    }\r\n                  },\r\n                  \"plan_expires_before_class\": {\r\n                    \"summary\": \"Plan expires before class\",\r\n                    \"value\": {\r\n                      \"success\": false,\r\n                      \"message\": \"Gói tập của bạn sẽ hết hạn ngày 25/09/2026, trước khi lớp học diễn ra ngày 30/09/2026. Vui lòng gia hạn gói để đặt lịch.\"\r\n                    }\r\n                  },\r\n                  \"premium_required\": {\r\n                    \"summary\": \"PREMIUM class requires PREMIUM plan\",\r\n                    \"value\": {\r\n                      \"success\": false,\r\n                      \"message\": \"Premium membership required to book this class.\"\r\n                    }\r\n                  },\r\n                  \"concurrent_class_limit_reached\": {\r\n                    \"summary\": \"Vượt quota lớp học song song (distinct Class)\",\r\n                    \"value\": {\r\n                      \"success\": false,\r\n                      \"message\": \"Bạn đã đạt giới hạn 3 lớp học song song của gói MEMBERSHIP. Vui lòng hủy hoặc chuyển một lớp đang đặt trước khi đăng ký lớp mới.\",\r\n                      \"errors\": {\r\n                        \"code\": \"CONCURRENT_CLASS_LIMIT_REACHED\",\r\n                        \"tier\": \"MEMBERSHIP\",\r\n                        \"limit\": 3,\r\n                        \"used\": 3,\r\n                        \"remaining\": 0\r\n                      }\r\n                    }\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"404\": {\r\n            \"$ref\": \"#/components/responses/NotFound\"\r\n          },\r\n          \"409\": {\r\n            \"$ref\": \"#/components/responses/Conflict\"\r\n          },\r\n          \"500\": {\r\n            \"$ref\": \"#/components/responses/ServerError\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/enrollments/my\": {\r\n      \"get\": {\r\n        \"summary\": \"Get current member's enrollments\",\r\n        \"tags\": [\r\n          \"Enrollments\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"query\",\r\n            \"name\": \"status\",\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"enum\": [\r\n                \"BOOKED\",\r\n                \"CANCELLED\",\r\n                \"COMPLETED\"\r\n              ]\r\n            }\r\n          },\r\n          {\r\n            \"in\": \"query\",\r\n            \"name\": \"page\",\r\n            \"schema\": {\r\n              \"type\": \"integer\"\r\n            }\r\n          },\r\n          {\r\n            \"in\": \"query\",\r\n            \"name\": \"limit\",\r\n            \"schema\": {\r\n              \"type\": \"integer\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"$ref\": \"#/components/responses/EnrollmentListOk\"\r\n          },\r\n          \"400\": {\r\n            \"$ref\": \"#/components/responses/BadRequest\"\r\n          },\r\n          \"401\": {\r\n            \"$ref\": \"#/components/responses/Unauthorized\"\r\n          },\r\n          \"403\": {\r\n            \"$ref\": \"#/components/responses/Forbidden\"\r\n          },\r\n          \"500\": {\r\n            \"$ref\": \"#/components/responses/ServerError\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/enrollments/my/courses\": {\r\n      \"get\": {\r\n        \"summary\": \"My courses — in-payment / ongoing at the top, purchase history below (Member only)\",\r\n        \"description\": \"Mỗi dòng là 1 khóa (Class) với `courseStatus`: PENDING_PAYMENT, UPCOMING, ONGOING, COMPLETED, CANCELLED, PAID_NOT_ENROLLED.\\n- `group=active` → PENDING_PAYMENT + UPCOMING + ONGOING (khu vực ở đầu màn Khóa học).\\n- `group=history` → COMPLETED + CANCELLED + PAID_NOT_ENROLLED (lịch sử mua).\\n- `status=A,B` (CSV) lọc tự do. Không truyền gì → tất cả, `active` xếp trước.\\nMỗi dòng có `payment` (method, gateway, amount, paidAt, pendingExpiresAt), `startDate`, `endDate`, `totalSessions`,\\n`completedSessions`, `nextSession`, `pendingRefund`, `canReview` (đã học xong + đã thanh toán), `myRating`.\\n\",\r\n        \"tags\": [\r\n          \"Enrollments\"\r\n        ],\r\n        \"security\": [\r\n          {\r\n            \"BearerAuth\": []\r\n          }\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"query\",\r\n            \"name\": \"group\",\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"enum\": [\r\n                \"active\",\r\n                \"history\"\r\n              ]\r\n            }\r\n          },\r\n          {\r\n            \"in\": \"query\",\r\n            \"name\": \"status\",\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"example\": \"ONGOING,UPCOMING\"\r\n          },\r\n          {\r\n            \"in\": \"query\",\r\n            \"name\": \"page\",\r\n            \"schema\": {\r\n              \"type\": \"integer\"\r\n            }\r\n          },\r\n          {\r\n            \"in\": \"query\",\r\n            \"name\": \"limit\",\r\n            \"schema\": {\r\n              \"type\": \"integer\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          },\r\n          \"401\": {\r\n            \"$ref\": \"#/components/responses/Unauthorized\"\r\n          },\r\n          \"403\": {\r\n            \"$ref\": \"#/components/responses/Forbidden\"\r\n          },\r\n          \"404\": {\r\n            \"$ref\": \"#/components/responses/NotFound\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/enrollments/my/quota\": {\r\n      \"get\": {\r\n        \"summary\": \"Get my concurrent-class quota (Member only)\",\r\n        \"description\": \"**Quota lớp học song song** — số Class KHÁC NHAU tối đa mà hội viên được giữ đồng thời,\\nlấy từ `MembershipPlan.maxConcurrentClasses` của MembershipSubscription đang ACTIVE.\\n\\nCách tính `used` (tính động từ DB, KHÔNG lưu counter trên Member):\\n- Chỉ tính `Enrollment.status = BOOKED` ở `ClassSchedule.status = SCHEDULED` và `startTime > now`.\\n- Đếm **DISTINCT Class**: một Class có nhiều buổi BOOKED vẫn chỉ chiếm 1 quota (`classes[]` có 1 entry/Class,\\n  kèm `futureBookedScheduleCount`; `scheduleId`/`scheduleStartTime` chỉ là buổi đại diện).\\n- KHÔNG tính: Enrollment `COMPLETED`/`CANCELLED`, buổi đã bắt đầu, buổi `CANCELLED`/`COMPLETED`.\\n\\n`remaining = max(0, limit - used)`. Transfer trong cùng Class (BR-08) không đổi quota.\\nDowngrade gói không tự hủy lớp đang giữ: có thể `used > limit` (grandfathering) nhưng\\n`remaining = 0` nên không đặt thêm Class mới cho tới khi `used < limit`.\\n\\nSubscription:\\n- Member mới được auto-provision gói **FREE** (`tier = FREE`, `maxConcurrentClasses = 0`) nên response\\n  thường có `hasActiveSubscription = true`, `tier = \\\"FREE\\\"`, `limit = 0`.\\n- Dữ liệu cũ/bất thường KHÔNG có subscription ACTIVE: `hasActiveSubscription = false`, `tier = null`,\\n  `limit = 0`, `used` = số Class đang giữ (nếu có), `remaining = 0`.\\n  `tier = null` KHÔNG có nghĩa là tier FREE.\\n\\nChỉ trả quota của CHÍNH hội viên đang đăng nhập (không có tham số `memberId`).\\n\",\r\n        \"tags\": [\r\n          \"Enrollments\"\r\n        ],\r\n        \"security\": [\r\n          {\r\n            \"BearerAuth\": []\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"$ref\": \"#/components/responses/ConcurrentClassQuotaOk\"\r\n          },\r\n          \"401\": {\r\n            \"$ref\": \"#/components/responses/Unauthorized\"\r\n          },\r\n          \"403\": {\r\n            \"$ref\": \"#/components/responses/Forbidden\"\r\n          },\r\n          \"404\": {\r\n            \"$ref\": \"#/components/responses/NotFound\"\r\n          },\r\n          \"500\": {\r\n            \"$ref\": \"#/components/responses/ServerError\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/enrollments/bulk\": {\r\n      \"post\": {\r\n        \"summary\": \"Enroll in a WHOLE course (all upcoming sessions of a class) — Member self-enrolls; Staff/Manager for a member\",\r\n        \"description\": \"**Đăng ký TRỌN KHÓA — ALL-OR-NOTHING.**\\n\\nTạo (hoặc kích hoạt lại) Enrollment cho **tất cả** buổi `ClassSchedule.status = SCHEDULED`\\nchưa bắt đầu của Class. Cả khóa chỉ chiếm **1 quota** lớp học song song (distinct Class).\\n\\n**Chốt chặn nghiệp vụ (chạy sau khi đã advisory-lock memberQuota → memberClass → schedules):**\\n- Class tồn tại, đang hoạt động và **có ít nhất 1 buổi sắp diễn ra** (400 nếu không).\\n- Gói tập `ACTIVE` và **`endDate` phủ tới buổi CUỐI của khóa** (`SUBSCRIPTION_ENDS_BEFORE_COURSE_END`).\\n- Class `PREMIUM` yêu cầu gói tier `PREMIUM` (`PREMIUM_REQUIRED`).\\n- Không bị hình phạt chuyên cần đang hiệu lực ở Class này (`ATTENDANCE_PENALTY_ACTIVE`).\\n- Không vượt `MembershipPlan.maxConcurrentClasses` (`CONCURRENT_CLASS_LIMIT_REACHED`).\\n- MỌI buổi còn sức chứa (`SESSION_FULL`) và không trùng giờ với buổi khác đã đặt (`TIME_CONFLICT`).\\n\\n**Chỉ cần 1 điều kiện fail ⇒ HTTP 409 `COURSE_ENROLLMENT_FAILED` với `errors.details[]`\\n(mỗi phần tử có `code`, `message`, `sessionId` khi lỗi thuộc một buổi) và transaction ROLLBACK:\\nKHÔNG buổi nào được tạo.** Điều kiện cấp khóa (gói tập / tier / quota / hình phạt) không có `sessionId`.\\n\\n**Idempotent**: buổi đã `BOOKED`/`COMPLETED` của chính hội viên trả về `status = ALREADY_BOOKED`\\n(không lỗi, không tạo trùng); buổi từng `CANCELLED` được kích hoạt lại (`REACTIVATED`, BR-07).\\nChỉ gửi **1 notification** `ENROLLMENT_CONFIRMED` cho cả khóa thay vì N notification.\\n\",\r\n        \"tags\": [\r\n          \"Courses\"\r\n        ],\r\n        \"security\": [\r\n          {\r\n            \"BearerAuth\": []\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"required\": true,\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"type\": \"object\",\r\n                \"required\": [\r\n                  \"classId\"\r\n                ],\r\n                \"properties\": {\r\n                  \"classId\": {\r\n                    \"type\": \"string\",\r\n                    \"format\": \"uuid\"\r\n                  },\r\n                  \"memberId\": {\r\n                    \"type\": \"string\",\r\n                    \"description\": \"Required when enrolled by Staff/Manager (nhận cả userId hoặc MemberProfile.id)\"\r\n                  }\r\n                }\r\n              },\r\n              \"example\": {\r\n                \"classId\": \"a1b2c3d4-0000-0000-0000-000000000010\"\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"responses\": {\r\n          \"201\": {\r\n            \"$ref\": \"#/components/responses/EnrollmentCreated\"\r\n          },\r\n          \"400\": {\r\n            \"$ref\": \"#/components/responses/BadRequest\"\r\n          },\r\n          \"401\": {\r\n            \"$ref\": \"#/components/responses/Unauthorized\"\r\n          },\r\n          \"403\": {\r\n            \"$ref\": \"#/components/responses/Forbidden\"\r\n          },\r\n          \"404\": {\r\n            \"$ref\": \"#/components/responses/NotFound\"\r\n          },\r\n          \"409\": {\r\n            \"description\": \"Một hoặc nhiều buổi không đủ điều kiện (all-or-nothing — không buổi nào được tạo)\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"type\": \"object\"\r\n                },\r\n                \"examples\": {\r\n                  \"session_full\": {\r\n                    \"summary\": \"Một buổi trong khóa đã hết chỗ\",\r\n                    \"value\": {\r\n                      \"success\": false,\r\n                      \"message\": \"Không thể đăng ký trọn khóa \\\"Yoga sáng\\\": 1 điều kiện chưa đạt.\",\r\n                      \"errors\": {\r\n                        \"code\": \"COURSE_ENROLLMENT_FAILED\",\r\n                        \"classId\": \"a1b2c3d4-0000-0000-0000-000000000010\",\r\n                        \"className\": \"Yoga sáng\",\r\n                        \"totalSessions\": 12,\r\n                        \"failedCount\": 1,\r\n                        \"details\": [\r\n                          {\r\n                            \"code\": \"SESSION_FULL\",\r\n                            \"message\": \"Buổi 18:00 05/10/2026 (Phòng Yoga 1) đã hết chỗ.\",\r\n                            \"sessionId\": \"b2c3d4e5-0000-0000-0000-000000000005\",\r\n                            \"roomName\": \"Phòng Yoga 1\",\r\n                            \"details\": {\r\n                              \"bookedCount\": 20,\r\n                              \"capacity\": 20\r\n                            }\r\n                          }\r\n                        ]\r\n                      }\r\n                    }\r\n                  },\r\n                  \"subscription_expires\": {\r\n                    \"summary\": \"Gói tập hết hạn trước buổi cuối của khóa\",\r\n                    \"value\": {\r\n                      \"success\": false,\r\n                      \"message\": \"Không thể đăng ký trọn khóa \\\"Yoga sáng\\\": 1 điều kiện chưa đạt.\",\r\n                      \"errors\": {\r\n                        \"code\": \"COURSE_ENROLLMENT_FAILED\",\r\n                        \"failedCount\": 1,\r\n                        \"details\": [\r\n                          {\r\n                            \"code\": \"SUBSCRIPTION_ENDS_BEFORE_COURSE_END\",\r\n                            \"message\": \"Gói tập của bạn hết hạn ngày 20/10/2026, trước buổi cuối của khóa ngày 19/11/2026. Vui lòng gia hạn gói để đăng ký trọn khóa.\",\r\n                            \"details\": {\r\n                              \"planEndDate\": \"2026-10-20T00:00:00.000Z\",\r\n                              \"lastSessionStartTime\": \"2026-11-19T01:00:00.000Z\",\r\n                              \"coveredSessions\": 6,\r\n                              \"totalSessions\": 12\r\n                            }\r\n                          }\r\n                        ]\r\n                      }\r\n                    }\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          },\r\n          \"500\": {\r\n            \"$ref\": \"#/components/responses/ServerError\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/enrollments/schedule/{scheduleId}\": {\r\n      \"get\": {\r\n        \"summary\": \"Get all enrollments for a schedule\",\r\n        \"tags\": [\r\n          \"Enrollments\"\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"path\",\r\n            \"name