ach, plan's Member, Manager)\",\r\n        \"tags\": [\r\n          \"Training Plans\"\r\n        ],\r\n        \"security\": [\r\n          {\r\n            \"BearerAuth\": []\r\n          }\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"path\",\r\n            \"name\": \"id\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          },\r\n          \"403\": {\r\n            \"$ref\": \"#/components/responses/Forbidden\"\r\n          },\r\n          \"404\": {\r\n            \"$ref\": \"#/components/responses/NotFound\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/training-plans/{id}/attachments/{attachmentId}\": {\r\n      \"get\": {\r\n        \"summary\": \"Download an attachment (authenticated)\",\r\n        \"tags\": [\r\n          \"Training Plans\"\r\n        ],\r\n        \"security\": [\r\n          {\r\n            \"BearerAuth\": []\r\n          }\r\n        ],\r\n        \"parameters\": [\r\n          {\r\n            \"in\": \"path\",\r\n            \"name\": \"id\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          },\r\n          {\r\n            \"in\": \"path\",\r\n            \"name\": \"attachmentId\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"File\"\r\n          },\r\n          \"403\": {\r\n            \"$ref\": \"#/components/responses/Forbidden\"\r\n          },\r\n          \"404\": {\r\n            \"$ref\": \"#/components/responses/NotFound\"\r\n          }\r\n        }\r\n      },\r\n      \"delete\": {\r\n        \"summary\": \"