 .cr-cell-main a:hover { color: var(--primary-text); }
+/* Tên trong bảng mở hộp chi tiết (nút trông như liên kết). */
+.cr-link { all: unset; cursor: pointer; font-weight: 500; color: var(--text); }
+.cr-link:hover { color: var(--primary-text); }
+.cr-link:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 4px; }
 .cr-cell-main small { color: var(--text-3); font-size: 12.5px; }
 .cr-cell-media { display: flex; align-items: center; gap: 12px; min-width: 0; }
 .cr-row-actions { display: inline-flex; gap: 2px; justify-content: flex-end; }
