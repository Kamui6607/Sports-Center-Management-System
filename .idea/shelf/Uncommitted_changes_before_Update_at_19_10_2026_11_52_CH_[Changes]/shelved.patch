: 40px; height: 40px; font-size: 15px; }\r\n.cr-menu-pop {\r\n  position: absolute; right: 0; top: calc(100% + 8px); min-width: 250px; z-index: 40; padding: 6px;\r\n  background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); box-shadow: var(--shadow-pop);\r\n  animation: cr-pop 0.14s var(--ease);\r\n}\r\n.cr-menu-head { padding: 8px 10px 10px; border-bottom: 1px solid var(--border); margin-bottom: 4px; }\r\n.cr-menu-head strong { display: block; font-weight: 600; }\r\n.cr-menu-head small { color: var(--text-3); font-size: 12.5px; }\r\n.cr-menu-item { width: 100%; display: flex; align-items: center; gap: 10px; height: 36px; padding: 0 10px; border: 0; background: none; border-radius: var(--r-sm); color: var(--text); font-size: 14px; cursor: pointer; text-align: left; }\r\n.cr-menu-item:hover, .cr-menu-item:focus-visible { background: var(--surface-hover); outline: none; }\r\n.cr-menu-item svg { color: var(--text-muted); }\r\n.cr-menu-item.danger { color: var(--danger-text); }\r\n.cr-menu-item.danger svg { color: var(--danger); }\r\n@keyframes cr-pop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }\r\n\r\n/* Theme segmented (trang tài khoản) */\r\n.cr-theme { display: inline-flex; padding: 3px; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface-2); gap: 2px; }\r\n.cr-theme button { height: 30px; padding: 0 12px; display: inline-flex; gap: 6px; align-items: center; border: 0; background: none; border-radius: var(--r-sm); color: var(--text-2); cursor: pointer; font-size: 13px; font-weight: 500; transition: background var(--t), color var(--t); }\r\n.cr-theme button:hover { color: var(--text); }\r\n.cr-theme button[aria-pressed=\"true\"] { background: var(--surface); color: var(--primary-text); box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border); }\r\n\r\n/* Chuông thông báo (component dùng chung) — đổi sang token */\r\n.cr .notification-bell { position: relati