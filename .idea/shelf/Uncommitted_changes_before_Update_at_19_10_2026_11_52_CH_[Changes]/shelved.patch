<+>generator client {\r\n  provider = \"prisma-client-js\"\r\n}\r\n\r\ndatasource db {\r\n  provider = \"postgresql\"\r\n  url      = env(\"DATABASE_URL\")\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// BaseEntity — field chung của MỌI model (Prisma không hỗ trợ kế thừa model,\r\n// nên mỗi model tự khai báo đủ 3 field dưới đây, ĐÚNG định nghĩa này):\r\n//\r\n//   id        String   @id @default(uuid())\r\n//   createdAt DateTime @default(now())\r\n//   updatedAt DateTime @default(now()) @updatedAt\r\n//\r\n// `@default(now())` của updatedAt giúp INSERT bằng SQL thô ($executeRaw) không lỗi NOT NULL.\r\n// Thêm model mới ⇒ khai báo đủ 3 field + thêm model vào `src/types/base-entity.ts`\r\n// (tsc sẽ báo lỗi nếu thiếu).\r\n// ─────────────────────────────────────────\r\n\r\n// ─────────────────────────────────────────\r\n// ENUMS\r\n// ─────────────────────────────────────────\r\n\r\nenum ClassApprovalStatus {\r\n  PENDING\r\n  APPROVED\r\n  REJECTED\r\n  COMPLETED\r\n}\r\n\r\nenum Gender {\r\n  MALE\r\n  FEMALE\r\n  OTHER\r\n}\r\n\r\nenum TrainingLevel {\r\n  BEGINNER\r\n  INTERMEDIATE\r\n  ADVANCED\r\n}\r\n\r\nenum ClassType {\r\n  REGULAR\r\n  PREMIUM\r\n}\r\n\r\nenum AreaType {\r\n  POOL\r\n  INDOOR\r\n  OUTDOOR\r\n}\r\n\r\nenum ScheduleStatus {\r\n  SCHEDULED\r\n  CANCELLED\r\n  COMPLETED\r\n}\r\n\r\n/// Phương án xử lý khi hủy buổi đã có học viên đặt chỗ (BE-20).\r\nenum ScheduleCancelResolution {\r\n  MAKEUP\r\n  REFUND\r\n}\r\n\r\nenum EnrollmentStatus {\r\n  BOOKED\r\n  CANCELLED\r\n  COMPLETED\r\n}\r\n\r\nenum PaymentMethod {\r\n  CASH\r\n  BANK_TRANSFER\r\n  SEPAY\r\n}\r\n\r\n/// Trạng thái xử lý một webhook SePay (bảng `SepayWebhookEvent`).\r\nenum SepayWebhookStatus {\r\n  PENDING // Đã claim sepayId, đang xử lý trong transaction (không thấy được nếu transaction rollback)\r\n  PROCESSED // Đã chốt giao dịch (kích hoạt gói)\r\n  DUPLICATE // Webhook lặp (cùng sepayId) hoặc giao dịch đã SUCCESS trước đó\r\n  LATE // Tiền về sau khi giao dịch đã đóng (hết hạn/thất bại) — cần đối soát, KHÔNG kích hoạt\r\n  MISMATCH // Lệch số tiền hoặc số tài khoản — cần đối soát, KHÔNG kích hoạt\r\n  IGNORED // Tiền ra / không khớp mã đơn nào — bỏ qua\r\n}\r\n\r\nenum PaymentStatus {\r\n  PENDING\r\n  SUCCESS\r\n  FAILED\r\n  REFUNDED\r\n}\r\n\r\n/// A06: trạng thái CẤP QUYỀN của giao dịch — tách khỏi `status` (trạng thái TIỀN).\r\n/// `REQUIRES_REVIEW` = tiền ĐÃ thu nhưng gói chưa được cấp (cần quản lý xử lý/đối soát).\r\nenum PaymentActivationStatus {\r\n  ACTIVATED\r\n  REQUIRES_REVIEW\r\n}\r\n\r\n/// F01: vòng đời bản ghi outbox notification.\r\nenum OutboxStatus {\r\n  PENDING\r\n  SENDING\r\n  SENT\r\n  FAILED\r\n}\r\n\r\n/// Kênh giao của một dòng outbox: thông báo trong app hoặc email (Brevo).\r\nenum OutboxChannel {\r\n  IN_APP\r\n  EMAIL\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// AUTH / USER\r\n// ─────────────────────────────────────────\r\n\r\n/// Vai trò người dùng (bảng tra cứu). Hệ thống dùng 3 dòng: MEMBER, COACH, MANAGER\r\n/// (tạo sẵn bởi migration `20261005010000_role_table` và `prisma/seed.ts`).\r\n/// Code tra vai trò theo `name` (UNIQUE) — xem `src/utils/roles.ts`.\r\nmodel Role {\r\n  id          String   @id @default(uuid())\r\n  name        String   @unique\r\n  description String?\r\n  createdAt   DateTime @default(now())\r\n  updatedAt   DateTime @default(now()) @updatedAt\r\n\r\n  users User[]\r\n}\r\n\r\nmodel User {\r\n  id          String    @id @default(uuid())\r\n  email       String    @unique\r\n  password    String\r\n  fullName    String\r\n  phone       String?   @unique\r\n  gender      Gender?\r\n  dateOfBirth DateTime?\r\n  avatarUrl   String?\r\n  roleId      String\r\n  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)\r\n  isActive    Boolean   @default(true)\r\n  /// Cửa hàng: tạm khóa đặt hàng tới thời điểm này (để đơn hết hạn quá nhiều lần) — null = không khóa.\r\n  checkoutLockedUntil DateTime?\r\n  createdAt   DateTime  @default(now())\r\n  updatedAt   DateTime  @default(now()) @updatedAt\r\n\r\n  memberProfile              MemberProfile?\r\n  coachProfile               CoachProfile?\r\n  managerProfile             ManagerProfile?\r\n  refreshTokens              RefreshToken[]\r\n  passwordResetOtp           PasswordResetOtp?\r\n  createdPayments            Payment[]              @relation(\"PaymentCreatedBy\")\r\n  sentMessages               ChatMessage[]          @relation(\"SentMessages\")\r\n  receivedMessages           ChatMessage[]          @relation(\"ReceivedMessages\")\r\n  chatAttachmentsOwned       ChatAttachment[]       @relation(\"ChatAttachmentOwner\")\r\n  chatAttachmentsReceived    ChatAttachment[]       @relation(\"ChatAttachmentReceiver\")\r\n  notifications              Notification[]\r\n  decidedAttendancePenalties AttendancePenalty[]    @relation(\"AttendancePenaltyDecidedBy\")\r\n  createdManualCodes         AttendanceManualCode[] @relation(\"AttendanceManualCodeCreatedBy\")\r\n  createdProducts            Product[]              @relation(\"ProductCreatedBy\")\r\n  productReviews             ProductReview[]        @relation(\"ProductReviewUser\")\r\n  orders                     Order[]                @relation(\"OrderUser\")\r\n  refundsRequested           Refund[]               @relation(\"RefundRequestedBy\")\r\n  refundsProcessed           Refund[]               @relation(\"RefundProcessedBy\")\r\n  cart                       Cart?\r\n  addresses                  UserAddress[]\r\n  trainingPlanAttachments    TrainingPlanAttachment[] @relation(\"TrainingPlanAttachmentUploader\")\r\n\r\n  @@index([roleId])\r\n}\r\n\r\n/// Mã OTP 6 số đặt lại mật khẩu (Mobile). Mỗi user tối đa 1 mã đang hiệu lực — gửi lại ⇒ ghi đè.\r\n/// Chỉ lưu HASH (bcrypt); hết hạn 15 phút; sai quá 5 lần ⇒ mã bị khóa; gửi lại tối thiểu sau 60 giây.\r\nmodel PasswordResetOtp {\r\n  id         String    @id @default(uuid())\r\n  userId     String    @unique\r\n  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  otpHash    String\r\n  expiresAt  DateTime\r\n  attempts   Int       @default(0)\r\n  lastSentAt DateTime\r\n  consumedAt DateTime?\r\n  createdAt  DateTime  @default(now())\r\n  updatedAt  DateTime  @default(now()) @updatedAt\r\n}\r\n\r\nmodel RefreshToken {\r\n  id        String    @id @default(uuid())\r\n  token     String    @unique\r\n  userId    String\r\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  expiresAt DateTime\r\n  revokedAt DateTime?\r\n  createdAt DateTime  @default(now())\r\n  updatedAt DateTime  @default(now()) @updatedAt\r\n\r\n  @@index([userId])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// PROFILES\r\n// ─────────────────────────────────────────\r\n\r\nmodel MemberProfile {\r\n  id                 String         @id @default(uuid())\r\n  userId             String         @unique\r\n  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  fitnessGoal        String?\r\n  trainingLevel      TrainingLevel?\r\n  trainingPreference String?\r\n  createdAt          DateTime       @default(now())\r\n  updatedAt          DateTime       @default(now()) @updatedAt\r\n\r\n  enrollments        Enrollment[]\r\n  payments           Payment[]\r\n  attendances        Attendance[]\r\n  trainingPlans      TrainingPlan[]\r\n  feedbacks          CoachFeedback[]\r\n  penalties          AttendancePenalty[]\r\n  manualCodeAttempts AttendanceManualCodeAttempt[]\r\n  refunds            Refund[]\r\n  memberships        Membership[]\r\n}\r\n\r\nenum CoachApprovalStatus {\r\n  PENDING\r\n  APPROVED\r\n  REJECTED\r\n}\r\n\r\nmodel CoachProfile {\r\n  id              String   @id @default(uuid())\r\n  userId          String   @unique\r\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  specialization  String?\r\n  experienceYears Int?\r\n  bio             String?\r\n  createdAt       DateTime @default(now())\r\n  updatedAt       DateTime @default(now()) @updatedAt\r\n\r\n  /// Hồ sơ chứng nhận HLV (CV) — xem model Certification.\r\n  certification Certification?\r\n  classes       Class[]\r\n  wallet        CoachWallet?\r\n  trainingPlans TrainingPlan[]\r\n  feedbacks     CoachFeedback[]\r\n}\r\n\r\n/// Hồ sơ chứng nhận HLV (CV) để Manager xét duyệt — 1–1 với CoachProfile.\r\n/// Nộp lại CV ⇒ GHI ĐÈ fileUrl, status về PENDING, xóa kết quả duyệt cũ.\r\n/// Duyệt APPROVED ⇒ tài khoản Coach được kích hoạt (User.isActive = true).\r\nmodel Certification {\r\n  id           String              @id @default(uuid())\r\n  coachId      String              @unique\r\n  coach        CoachProfile        @relation(fields: [coachId], references: [id], onDelete: Cascade)\r\n  /// Đường dẫn file CV (PDF). NULL = hồ sơ được duyệt khi chưa có luồng nộp CV (dữ liệu cũ / seed).\r\n  fileUrl      String?\r\n  status       CoachApprovalStatus @default(PENDING)\r\n  /// Thời điểm nộp CV lần gần nhất.\r\n  submittedAt  DateTime            @default(now())\r\n  /// Lý do Manager từ chối (chỉ có khi status = REJECTED; nộp lại CV thì xóa).\r\n  rejectReason String?\r\n  createdAt    DateTime            @default(now())\r\n  updatedAt    DateTime            @default(now()) @updatedAt\r\n\r\n  @@index([status])\r\n}\r\n\r\nmodel ManagerProfile {\r\n  id        String   @id @default(uuid())\r\n  userId    String   @unique\r\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  createdAt DateTime @default(now())\r\n  updatedAt DateTime @default(now()) @updatedAt\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// MEMBERSHIP\r\n// ─────────────────────────────────────────\r\n\r\n// ─────────────────────────────────────────\r\n// ROOMS\r\n// ─────────────────────────────────────────\r\n\r\nmodel Room {\r\n  id        String   @id @default(uuid())\r\n  name      String   @unique\r\n  capacity  Int\r\n  location  String?\r\n  areaType  AreaType\r\n  isActive  Boolean  @default(true)\r\n  createdAt DateTime @default(now())\r\n  updatedAt DateTime @default(now()) @updatedAt\r\n\r\n  schedules ClassSchedule[]\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// CLASS\r\n// ─────────────────────────────────────────\r\n\r\nmodel Class {\r\n  id          String  @id @default(uuid())\r\n  name        String\r\n  description String?\r\n  /// Mục tiêu của lớp (HLV ghi) để Member xem và tự đánh giá có phù hợp trước khi đăng ký.\r\n  /// Khác MemberProfile.fitnessGoal (mục tiêu của Member, để HLV đọc).\r\n  goal        String?\r\n  /// Môn tập của lớp (Yoga, HIIT, Bơi...). Chuỗi tự do do Coach nhập — KHÔNG còn bảng bộ môn / quan hệ nhiều-nhiều.\r\n  fitness     String\r\n\r\n  price       Decimal             @default(0) @db.Decimal(12, 2)\r\n  status      ClassApprovalStatus @default(PENDING)\r\n  /// BE-2: lý do Manager từ chối (xóa khi Coach gửi lại — BE-3).\r\n  rejectReason String?\r\n  /// HLV tạo và phụ trách lớp — mỗi lớp đúng 1 HLV (nhận 85% doanh thu). Chỉ Coach được tạo lớp.\r\n  coachId     String\r\n  coach       CoachProfile        @relation(fields: [coachId], references: [id])\r\n  capacity    Int\r\n  classType   ClassType           @default(REGULAR)\r\n  // Khu vực mà lớp học yêu cầu (POOL | INDOOR | OUTDOOR).\r\n  // Khác với classType (REGULAR | PREMIUM là hạng lớp).\r\n  areaType    AreaType\r\n  isActive    Boolean             @default(true)\r\n  createdAt   DateTime            @default(now())\r\n  updatedAt   DateTime            @default(now()) @updatedAt\r\n\r\n  schedules          ClassSchedule[]\r\n  feedbacks          CoachFeedback[]\r\n  penalties          AttendancePenalty[]\r\n  walletTransactions WalletTransaction[]\r\n  payments           Payment[]\r\n  refunds            Refund[]\r\n\r\n  @@index([coachId])\r\n}\r\n\r\nmodel ClassSchedule {\r\n  id        String         @id @default(uuid())\r\n  classId   String\r\n  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)\r\n  roomId    String\r\n  room      Room           @relation(fields: [roomId], references: [id])\r\n  startTime DateTime\r\n  endTime   DateTime\r\n  status    ScheduleStatus @default(SCHEDULED)\r\n  /// BE-20: lý do & phương án khi buổi bị hủy (null nếu chưa hủy / hủy khi chưa ai đặt chỗ).\r\n  cancelReason     String?\r\n  cancelResolution ScheduleCancelResolution?\r\n  /// Buổi DẠY BÙ: trỏ tới buổi bị hủy mà buổi này thay thế (NULL = buổi chính của lớp).\r\n  /// Tiền 1 buổi khi hoàn = tiền lớp ÷ số buổi CHÍNH (không tính buổi bù).\r\n  makeupForId String?        @unique\r\n  makeupFor   ClassSchedule? @relation(\"ScheduleMakeup\", fields: [makeupForId], references: [id], onDelete: SetNull)\r\n  makeup      ClassSchedule? @relation(\"ScheduleMakeup\")\r\n  createdAt DateTime       @default(now())\r\n  updatedAt DateTime       @default(now()) @updatedAt\r\n\r\n  enrollments Enrollment[]\r\n  attendances Attendance[]\r\n  manualCodes AttendanceManualCode[]\r\n  refunds     Refund[]\r\n\r\n  @@index([classId])\r\n  @@index([roomId])\r\n  @@index([startTime, endTime])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// ENROLLMENT\r\n// ─────────────────────────────────────────\r\n\r\nmodel Enrollment {\r\n  id          String           @id @default(uuid())\r\n  memberId    String\r\n  member      MemberProfile    @relation(fields: [memberId], references: [id])\r\n  /// Giữ chỗ theo TỪNG BUỔI; lớp của buổi lấy qua `schedule.classId` (không lưu trùng classId).\r\n  scheduleId  String\r\n  schedule    ClassSchedule    @relation(fields: [scheduleId], references: [id])\r\n  status      EnrollmentStatus @default(BOOKED)\r\n  bookedAt    DateTime         @default(now())\r\n  cancelledAt DateTime?\r\n  createdAt   DateTime         @default(now())\r\n  updatedAt   DateTime         @default(now()) @updatedAt\r\n\r\n  @@unique([memberId, scheduleId])\r\n  @@index([memberId])\r\n  @@index([scheduleId])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// PAYMENT\r\n// ─────────────────────────────────────────\r\n\r\nmodel Payment {\r\n  id                String                   @id @default(uuid())\r\n  /// NULL khi người mua không phải hội viên (HLV mua sản phẩm) — người mua lấy từ Order.userId.\r\n  memberId          String?\r\n  member            MemberProfile?           @relation(fields: [memberId], references: [id], onDelete: Restrict)\r\n  /// Gói hội viên mà giao dịch này muốn mua — cần cho giao dịch ONLINE: Payment PENDING\r\n  /// được tạo TRƯỚC khi có subscription (chỉ tạo subscription khi cổng thanh toán xác nhận SUCCESS).\r\n  amount            Decimal                  @db.Decimal(12, 2)\r\n  method            PaymentMethod\r\n  classId           String?\r\n  class             Class?                   @relation(fields: [classId], references: [id])\r\n  classNameSnapshot String?\r\n  /// Đơn mua sản phẩm mà giao dịch này thanh toán. Một giao dịch chỉ trỏ tới classId HOẶC orderId.\r\n  orderId           String?                  @unique\r\n  order             Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)\r\n  status            PaymentStatus            @default(PENDING)\r\n  /// Mã đơn/mã thanh toán duy nhất — với giao dịch SePay đây là mã SePay bóc tách từ nội dung CK.\r\n  transactionCode   String?                  @unique\r\n  /// Cổng thanh toán online (VD \"SEPAY\"). NULL cho giao dịch tại quầy (CASH/BANK_TRANSFER).\r\n  gateway           String?\r\n  /// Mã giao dịch phía ngân hàng/SePay (referenceCode) để đối soát.\r\n  gatewayTransId    String?\r\n  /// Metadata thô của webhook SePay (payload đầy đủ + thông tin QR) để audit & tra soát.\r\n  gatewayPayload    Json?\r\n  note              String?\r\n  paidAt            DateTime?\r\n  /// A07 — snapshot điều khoản gói TẠI THỜI ĐIỂM TẠO ĐƠN: chốt tiền theo đúng offer đã bán,\r\n  /// không đọc cấu hình plan hiện tại (giá/duration/tier/quota có thể bị sửa trong lúc chờ CK).\r\n  /// A06 — trạng thái CẤP QUYỀN (tách khỏi `status` là trạng thái TIỀN). NULL = giao dịch\r\n  /// chưa chốt/không cần theo dõi (dữ liệu cũ).\r\n  activationStatus  PaymentActivationStatus?\r\n  /// Lý do cần đối soát (VD: PLAN_MISSING / thông điệp chặn kích hoạt) — null khi đã xử lý.\r\n  reviewReason      String?\r\n  reviewedAt        DateTime?\r\n  reviewedById      String?\r\n  createdById       String?\r\n  createdBy         User?                    @relation(\"PaymentCreatedBy\", fields: [createdById], references: [id])\r\n  createdAt         DateTime                 @default(now())\r\n  updatedAt         DateTime                 @default(now()) @updatedAt\r\n\r\n  sepayWebhookEvents SepayWebhookEvent[]\r\n  bankTransactions   SepayBankTransaction[]\r\n  refunds            Refund[]\r\n  walletTransactions WalletTransaction[]\r\n  /// Gói thành viên được cấp khi giao dịch mua gói (note `MEMBERSHIP_PLAN:<planId>`) thu tiền thành công.\r\n  membership         Membership?\r\n\r\n  @@index([memberId])\r\n  @@index([status])\r\n  @@index([createdAt])\r\n  @@index([gateway, status])\r\n  @@index([activationStatus])\r\n}\r\n\r\n/// A14 — Ledger giao dịch ngân hàng (SePay): một movement chỉ được ghi nhận & phân bổ MỘT LẦN,\r\n/// dùng chung cho webhook và đối soát API ⇒ idempotency xuyên hai kênh.\r\nmodel SepayBankTransaction {\r\n  id               String    @id @default(uuid())\r\n  /// Danh tính chuẩn hoá của movement: `ref:<referenceCode>` khi có (chung cho webhook + API),\r\n  /// ngược lại `sepay:<payload.id>` (webhook/mock) hoặc `api:<uuid>` (đối soát API).\r\n  externalId       String    @unique\r\n  sepayId          Int?      @unique\r\n  apiTransactionId String?   @unique\r\n  referenceCode    String?\r\n  gateway          String?\r\n  accountNumber    String?\r\n  transferType     String\r\n  amount           Decimal   @db.Decimal(12, 2)\r\n  content          String?\r\n  /// Mã đơn bóc tách được tại thời điểm ghi ledger.\r\n  code             String?\r\n  payload          Json?\r\n  /// MỘT movement chỉ được cấp quyền cho ĐÚNG MỘT payment (UNIQUE) — chống cấp gói 2 lần.\r\n  paymentId        String?   @unique\r\n  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)\r\n  allocatedAt      DateTime?\r\n  createdAt        DateTime  @default(now())\r\n  updatedAt        DateTime  @default(now()) @updatedAt\r\n\r\n  @@index([createdAt])\r\n  @@index([referenceCode])\r\n}\r\n\r\n/// F01 — Transactional outbox cho notification: ghi TRONG transaction nghiệp vụ, gửi SAU commit,\r\n/// retry khi lỗi ⇒ không mất thông báo khi transaction rollback hoặc process chết giữa chừng.\r\nmodel NotificationOutbox {\r\n  id          String       @id @default(uuid())\r\n  userId      String\r\n  /// IN_APP ⇒ tạo Notification; EMAIL ⇒ gửi qua Brevo (title = subject, body = HTML, email = người nhận).\r\n  channel     OutboxChannel @default(IN_APP)\r\n  email       String?\r\n  type        String\r\n  title       String\r\n  body        String\r\n  reason      String?\r\n  metadata    Json?\r\n  status      OutboxStatus @default(PENDING)\r\n  attempts    Int          @default(0)\r\n  lastError   String?\r\n  availableAt DateTime     @default(now())\r\n  sentAt      DateTime?\r\n  createdAt   DateTime     @default(now())\r\n  updatedAt   DateTime     @default(now()) @updatedAt\r\n\r\n  @@index([status, availableAt])\r\n  @@index([userId])\r\n}\r\n\r\n/// Log webhook nhận từ SePay — `sepayId` UNIQUE chống xử lý trùng khi SePay retry/replay webhook.\r\n/// Một giao dịch chuyển khoản chỉ được kích hoạt gói ĐÚNG MỘT LẦN (claim + chốt trong cùng transaction).\r\nmodel SepayWebhookEvent {\r\n  id        String             @id @default(uuid())\r\n  /// `payload.id` của SePay — không đổi qua mọi lần retry/replay.\r\n  sepayId   Int                @unique\r\n  paymentId String?\r\n  payment   Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)\r\n  status    SepayWebhookStatus @default(PENDING)\r\n  /// Lý do trạng thái cuối (VD ORDER_NOT_FOUND, AMOUNT_MISMATCH, LATE_RESULT…).\r\n  reason    String?\r\n  payload   Json\r\n  createdAt DateTime           @default(now())\r\n  updatedAt DateTime           @default(now()) @updatedAt\r\n\r\n  @@index([paymentId])\r\n  @@index([createdAt])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// CHAT MESSAGE\r\n// ─────────────────────────────────────────\r\n\r\nmodel ChatMessage {\r\n  id         String   @id @default(uuid())\r\n  senderId   String\r\n  sender     User     @relation(\"SentMessages\", fields: [senderId], references: [id])\r\n  receiverId String?\r\n  receiver   User?    @relation(\"ReceivedMessages\", fields: [receiverId], references: [id])\r\n  content    String?\r\n  fileUrl    String?\r\n  isRead     Boolean  @default(false)\r\n  createdAt  DateTime @default(now())\r\n  updatedAt  DateTime @default(now()) @updatedAt\r\n\r\n  attachment ChatAttachment?\r\n\r\n  @@index([senderId])\r\n  @@index([receiverId])\r\n  @@index([createdAt])\r\n}\r\n\r\n/// D03 — Metadata của file chat (KHÔNG phục vụ tĩnh công khai):\r\n/// quyết định AI được tải file (owner / receiver / MANAGER; phòng chung = mọi user đăng nhập)\r\n/// và cho phép dọn file khi request bị từ chối.\r\nmodel ChatAttachment {\r\n  id         String       @id @default(uuid())\r\n  ownerId    String\r\n  owner      User         @relation(\"ChatAttachmentOwner\", fields: [ownerId], references: [id])\r\n  /// Người nhận (NULL = phòng chung).\r\n  receiverId String?\r\n  receiver   User?        @relation(\"ChatAttachmentReceiver\", fields: [receiverId], references: [id])\r\n  messageId  String?      @unique\r\n  message    ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)\r\n  /// Tên file trên disk do SERVER sinh (không dùng tên gốc của client).\r\n  storedName String\r\n  mimeType   String\r\n  size       Int\r\n  createdAt  DateTime     @default(now())\r\n  updatedAt  DateTime     @default(now()) @updatedAt\r\n\r\n  @@index([ownerId])\r\n  @@index([receiverId])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// TRAINING & ATTENDANCE (FLOW 4)\r\n// ─────────────────────────────────────────\r\n\r\nenum AttendanceStatus {\r\n  PRESENT\r\n  ABSENT\r\n  LATE\r\n  EXCUSED\r\n}\r\n\r\nmodel Attendance {\r\n  id         String           @id @default(uuid())\r\n  scheduleId String\r\n  schedule   ClassSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)\r\n  memberId   String\r\n  member     MemberProfile    @relation(fields: [memberId], references: [id], onDelete: Cascade)\r\n  status     AttendanceStatus @default(PRESENT)\r\n  note       String?\r\n  createdAt  DateTime         @default(now())\r\n  updatedAt  DateTime         @default(now()) @updatedAt\r\n\r\n  @@unique([scheduleId, memberId])\r\n  @@index([scheduleId])\r\n  @@index([memberId])\r\n}\r\n\r\n/// Mã dự phòng nhập tay cho Member không quét được QR (camera/điện thoại lỗi).\r\n/// Sinh cùng lượt với QR ở POST /attendance/generate-qr; TTL ngắn (90s) và mã cũ của cùng\r\n/// buổi học bị thu hồi khi mã mới được cấp (mỗi thời điểm chỉ có 1 mã hợp lệ / schedule).\r\n/// `attempts` đếm số lần nhập SAI vào chính mã này; vượt ngưỡng → mã bị vô hiệu (revokedAt).\r\nmodel AttendanceManualCode {\r\n  id         String        @id @default(uuid())\r\n  code       String        @unique\r\n  scheduleId String\r\n  schedule   ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)\r\n  expiresAt  DateTime\r\n  /// userId (COACH/MANAGER) đã cấp mã — audit.\r\n  createdBy  String\r\n  creator    User          @relation(\"AttendanceManualCodeCreatedBy\", fields: [createdBy], references: [id], onDelete: Cascade)\r\n  attempts   Int           @default(0)\r\n  revokedAt  DateTime?\r\n  createdAt  DateTime      @default(now())\r\n  updatedAt  DateTime      @default(now()) @updatedAt\r\n\r\n  attemptLogs AttendanceManualCodeAttempt[]\r\n\r\n  @@index([scheduleId, expiresAt])\r\n  @@index([createdBy])\r\n}\r\n\r\n/// Log mọi lần thử nhập mã dự phòng (kể cả sai/hết hạn) — dùng cho rate-limit theo member + audit.\r\nmodel AttendanceManualCodeAttempt {\r\n  id        String                @id @default(uuid())\r\n  memberId  String\r\n  member    MemberProfile         @relation(fields: [memberId], references: [id], onDelete: Cascade)\r\n  codeId    String?\r\n  code      AttendanceManualCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)\r\n  success   Boolean\r\n  createdAt DateTime              @default(now())\r\n  updatedAt DateTime              @default(now()) @updatedAt\r\n\r\n  @@index([memberId, createdAt])\r\n}\r\n\r\nenum AttendancePenaltyStatus {\r\n  /// Reserved: hiện KHÔNG có flow nào persist PENDING (preview là read-only, apply tạo thẳng APPLIED).\r\n  /// Giữ lại cho luồng \"đề xuất chờ duyệt\" trong tương lai; không tạo record PENDING giả.\r\n  PENDING\r\n  APPLIED\r\n  REVOKED\r\n  EXPIRED\r\n}\r\n\r\n/// Lịch sử hình phạt chuyên cần theo (member × class): thu hồi slot tương lai + chặn đặt lại.\r\nmodel AttendancePenalty {\r\n  id                    String                  @id @default(uuid())\r\n  memberId              String\r\n  member                MemberProfile           @relation(fields: [memberId], references: [id], onDelete: Cascade)\r\n  classId               String\r\n  class                 Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)\r\n  reason                String\r\n  attendanceRate        Float\r\n  sampleSize            Int\r\n  releasedCount         Int                     @default(0)\r\n  releasedEnrollmentIds Json?\r\n  blockedUntil          DateTime?\r\n  status                AttendancePenaltyStatus @default(PENDING)\r\n  decidedBy             String?\r\n  decider               User?                   @relation(\"AttendancePenaltyDecidedBy\", fields: [decidedBy], references: [id], onDelete: SetNull)\r\n  decidedAt             DateTime?\r\n  appealReason          String?\r\n  appealedAt            DateTime?\r\n  revokedBy             String?\r\n  revokedAt             DateTime?\r\n  revokedReason         String?\r\n  createdAt             DateTime                @default(now())\r\n  updatedAt             DateTime                @default(now()) @updatedAt\r\n\r\n  @@index([memberId, classId])\r\n  @@index([status, blockedUntil])\r\n}\r\n\r\nmodel TrainingPlan {\r\n  id          String        @id @default(uuid())\r\n  memberId    String\r\n  member      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)\r\n  coachId     String\r\n  coach       CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Cascade)\r\n  name        String\r\n  description String?\r\n  startDate   DateTime\r\n  endDate     DateTime\r\n  isActive    Boolean       @default(true)\r\n  createdAt   DateTime      @default(now())\r\n  updatedAt   DateTime      @default(now()) @updatedAt\r\n\r\n  results     TrainingResult[]\r\n  /// Tệp (PDF/Excel) Coach đính kèm vào lộ trình cho học viên.\r\n  attachments TrainingPlanAttachment[]\r\n\r\n  @@index([memberId])\r\n  @@index([coachId])\r\n}\r\n\r\n/// Tệp PDF/Excel đính kèm lộ trình tập luyện. Lưu RIÊNG trên disk (`uploads/plans`, không phục vụ tĩnh) —\r\n/// chỉ tải qua API có kiểm tra quyền (Coach của kế hoạch, Member của kế hoạch, Manager).\r\nmodel TrainingPlanAttachment {\r\n  id           String       @id @default(uuid())\r\n  planId       String\r\n  plan         TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)\r\n  uploadedById String\r\n  uploadedBy   User         @relation(\"TrainingPlanAttachmentUploader\", fields: [uploadedById], references: [id])\r\n  /// Tên file gốc người dùng thấy (đã làm sạch); KHÔNG dùng để lưu trên disk.\r\n  originalName String\r\n  /// Tên file trên disk do SERVER sinh.\r\n  storedName   String\r\n  mimeType     String\r\n  size         Int\r\n  createdAt    DateTime     @default(now())\r\n  updatedAt    DateTime     @default(now()) @updatedAt\r\n\r\n  @@index([planId])\r\n}\r\n\r\nmodel TrainingResult {\r\n  id        String       @id @default(uuid())\r\n  planId    String\r\n  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)\r\n  date      DateTime\r\n  metrics   Json? // Custom metrics like weight, body fat\r\n  coachNote String?\r\n  createdAt DateTime     @default(now())\r\n  updatedAt DateTime     @default(now()) @updatedAt\r\n\r\n  @@index([planId])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// COACH FEEDBACK\r\n// ─────────────────────────────────────────\r\n\r\nmodel CoachFeedback {\r\n  id          String        @id @default(uuid())\r\n  coachId     String\r\n  coach       CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Cascade)\r\n  memberId    String\r\n  member      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)\r\n  classId     String?\r\n  class       Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)\r\n  rating      Int // 1-5 sao\r\n  comment     String?\r\n  isAnonymous Boolean       @default(false)\r\n  createdAt   DateTime      @default(now())\r\n  updatedAt   DateTime      @default(now()) @updatedAt\r\n\r\n  @@unique([coachId, memberId, classId])\r\n  @@index([coachId])\r\n  @@index([memberId])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// NOTIFICATIONS (BR-24)\r\n// ─────────────────────────────────────────\r\n\r\nenum NotificationType {\r\n  // ── Tài khoản ──\r\n  MEMBER_REGISTERED // Chào mừng hội viên mới đăng ký\r\n  // ── Chat ──\r\n  CHAT_MESSAGE // Nhận tin nhắn mới\r\n  // ── Gói tập ──\r\n  // ── Lịch học ──\r\n  UPCOMING_CLASS // Nhắc lớp sắp học (24h trước)\r\n  SCHEDULE_CANCELLED // Lịch học bị hủy\r\n  SCHEDULE_UPDATED // Lịch học được dời giờ\r\n  // ── Đặt lớp ──\r\n  ENROLLMENT_CONFIRMED // Đặt lớp thành công\r\n  ENROLLMENT_CANCELLED // Hủy đặt lớp\r\n  // ── Kế hoạch tập luyện ──\r\n  TRAINING_PLAN_ASSIGNED // HLV giao kế hoạch tập mới\r\n  // ── Lớp học ──\r\n  CLASS_APPROVED\r\n  CLASS_REJECTED\r\n  WITHDRAWAL_APPROVED\r\n  WITHDRAWAL_REJECTED\r\n  NEW_CLASS // Lớp học mới được mở\r\n  COACH_CHANGED // Đổi HLV cho lớp\r\n  // ── Chuyên cần (Attendance) ──\r\n  ATTENDANCE_WARNING // Cảnh báo chuyên cần dưới 80%\r\n  ATTENDANCE_PENALTY // Hình phạt chuyên cần: thu hồi slot + chặn đặt lại\r\n  ATTENDANCE_PENALTY_REVOKED // Hình phạt chuyên cần được gỡ\r\n  SCHEDULE_ROOM_CHANGED // Lịch học đổi phòng (bulk transfer Room hư)\r\n  // ── Thanh toán ──\r\n  PAYMENT_SUCCESS // Thanh toán thành công\r\n  PAYMENT_REFUNDED // Hoàn tiền\r\n  // ── Cửa hàng ──\r\n  ORDER_UPDATED // Đơn hàng đổi trạng thái (đã thanh toán, sẵn sàng nhận, đang giao, hết hạn…)\r\n  // ── Chung ──\r\n  GENERAL\r\n}\r\n\r\nmodel Notification {\r\n  id        String           @id @default(uuid())\r\n  userId    String\r\n  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  type      NotificationType\r\n  title     String\r\n  body      String\r\n  reason    String? // Lý do (dùng cho hủy gói, hủy lịch…)\r\n  isRead    Boolean          @default(false)\r\n  readAt    DateTime?\r\n  metadata  Json? // e.g. { scheduleId, classId, subscriptionId, senderId }\r\n  createdAt DateTime         @default(now())\r\n  updatedAt DateTime         @default(now()) @updatedAt\r\n\r\n  @@index([userId])\r\n  @@index([isRead])\r\n  @@index([createdAt])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// COACH WALLET\r\n// ─────────────────────────────────────────\r\n\r\nmodel CoachWallet {\r\n  id        String       @id @default(uuid())\r\n  coachId   String       @unique\r\n  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)\r\n  balance   Decimal      @default(0) @db.Decimal(12, 2)\r\n  createdAt DateTime     @default(now())\r\n  updatedAt DateTime     @default(now()) @updatedAt\r\n\r\n  transactions WalletTransaction[]\r\n  refunds      Refund[]\r\n}\r\n\r\nenum TransactionType {\r\n  DEPOSIT\r\n  WITHDRAWAL\r\n  /// Trừ ví HLV khi hoàn tiền cho hội viên (hủy khóa / hủy buổi không dạy bù).\r\n  REFUND_DEBIT\r\n}\r\n\r\nenum TransactionStatus {\r\n  PENDING\r\n  COMPLETED\r\n  REJECTED\r\n  FAILED\r\n}\r\n\r\nmodel WalletTransaction {\r\n  id        String            @id @default(uuid())\r\n  walletId  String\r\n  wallet    CoachWallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)\r\n  amount    Decimal           @db.Decimal(12, 2)\r\n  type      TransactionType\r\n  status    TransactionStatus @default(PENDING)\r\n  classId   String?\r\n  class     Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)\r\n  /// Giao dịch thanh toán gốc (DEPOSIT: tiền lớp được cộng vào ví; REFUND_DEBIT: tiền hoàn bị trừ).\r\n  paymentId String?\r\n  payment   Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)\r\n  bankInfo  Json?\r\n  note      String?\r\n  createdAt DateTime          @default(now())\r\n  updatedAt DateTime          @default(now()) @updatedAt\r\n\r\n  @@index([walletId])\r\n  @@index([status])\r\n  @@index([paymentId])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// HOÀN TIỀN (REFUND)\r\n// ─────────────────────────────────────────\r\n\r\nenum RefundReason {\r\n  MEMBER_CANCEL_COURSE // Hội viên hủy khóa trước khai giảng ≥ 3 ngày — hoàn 100% phần còn lại của giao dịch (hủy muộn hơn: không hoàn, không tạo Refund)\r\n  MEMBER_CANCEL_SESSION // Hội viên hủy MỘT buổi lẻ trước giờ học ≥ 24h — hoàn 80% tiền của buổi đó\r\n  SESSION_CANCELLED // Buổi học bị hủy và chọn hoàn tiền (không dạy bù) — hoàn tiền 1 buổi\r\n  ORDER_CANCELLED // Đơn hàng đã thanh toán bị hủy (khách yêu cầu / trung tâm hủy) — hoàn toàn bộ\r\n  ORDER_NOT_PICKED_UP // Khách không đến lấy hàng đúng hạn — hoàn theo chính sách (SHOP_NOT_PICKED_UP_REFUND_PERCENT)\r\n  ORDER_LATE_PAYMENT // Tiền về sau khi đơn đã hết hạn/hủy — không khôi phục đơn, hoàn lại tiền\r\n}\r\n\r\nenum RefundStatus {\r\n  PENDING // Chờ Manager chuyển khoản tay rồi duyệt\r\n  COMPLETED // Đã hoàn: ví HLV đã bị trừ, hội viên đã nhận tiền\r\n  REJECTED // Manager từ chối (kèm lý do)\r\n  CANCELLED // Người gửi tự hủy yêu cầu khi còn PENDING\r\n}\r\n\r\n/// Yêu cầu hoàn tiền cho hội viên. SePay không có API hoàn ⇒ Manager chuyển khoản tay rồi duyệt;\r\n/// lúc duyệt mới trừ ví HLV (`coachDebitAmount`) và (nếu hủy khóa) đổi Payment sang REFUNDED.\r\nmodel Refund {\r\n  id               String        @id @default(uuid())\r\n  paymentId        String\r\n  payment          Payment       @relation(fields: [paymentId], references: [id])\r\n  /// Hội viên nhận hoàn (null khi người mua đơn hàng là HLV — người nhận lấy từ `order.userId`).\r\n  memberId         String?\r\n  member           MemberProfile? @relation(fields: [memberId], references: [id], onDelete: Restrict)\r\n  /// Đơn hàng được hoàn (lý do ORDER_*); null với hoàn tiền khóa học.\r\n  orderId          String?\r\n  order            Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)\r\n  classId          String?\r\n  class            Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)\r\n  /// Buổi bị hủy (chỉ với SESSION_CANCELLED).\r\n  scheduleId       String?\r\n  schedule         ClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)\r\n  reason           RefundReason\r\n  /// Số tiền hoàn cho hội viên.\r\n  amount           Decimal       @db.Decimal(12, 2)\r\n  /// Phần trừ vào ví HLV khi duyệt (tỷ lệ theo số tiền HLV đã được cộng từ giao dịch gốc).\r\n  coachDebitAmount Decimal       @default(0) @db.Decimal(12, 2)\r\n  coachWalletId    String?\r\n  coachWallet      CoachWallet?  @relation(fields: [coachWalletId], references: [id], onDelete: SetNull)\r\n  note             String?\r\n  /// L8: ghi chú của Member khi gửi yêu cầu (cột `note` cũ giữ cho Web).\r\n  memberNote       String?\r\n  /// L8: ghi chú của Manager khi duyệt (VD mã giao dịch chuyển khoản hoàn tiền).\r\n  managerNote      String?\r\n  /// Ngân hàng nhận tiền hoàn (tên hoặc mã, VD: MBBank, VCB). Null với hoàn tiền đơn hàng.\r\n  bankName         String?\r\n  /// Số tài khoản nhận tiền hoàn.\r\n  bankAccountNumber String?\r\n  /// Tên chủ tài khoản nhận tiền hoàn (in hoa).\r\n  bankAccountName  String?\r\n  status           RefundStatus  @default(PENDING)\r\n  requestedById    String?\r\n  requestedBy      User?         @relation(\"RefundRequestedBy\", fields: [requestedById], references: [id], onDelete: SetNull)\r\n  processedById    String?\r\n  processedBy      User?         @relation(\"RefundProcessedBy\", fields: [processedById], references: [id], onDelete: SetNull)\r\n  processedAt      DateTime?\r\n  rejectReason     String?\r\n  createdAt        DateTime      @default(now())\r\n  updatedAt        DateTime      @default(now()) @updatedAt\r\n\r\n  /// Một buổi bị hủy chỉ hoàn MỘT lần cho mỗi giao dịch.\r\n  @@unique([paymentId, scheduleId])\r\n  @@index([status])\r\n  @@index([memberId])\r\n  @@index([coachWalletId, status])\r\n  @@index([orderId])\r\n}\r\n\r\n// ─────────────────────────────────────────\r\n// CỬA HÀNG (Product, Cart, Order…) — xem Doc/SHOP_FLOW_DESIGN.md\r\n// ─────────────────────────────────────────\r\n\r\nmodel Product {\r\n  id            String          @id @default(uuid())\r\n  name          String\r\n  description   String\r\n  price         Decimal         @db.Decimal(12, 2)\r\n  /// Tồn THỰC TẾ trên kệ. Có thể bán = `stockQuantity − reservedStock` (API trả `availableStock`).\r\n  stockQuantity Int             @default(0)\r\n  /// Số lượng đang GIỮ cho đơn chờ thanh toán (PENDING_PAYMENT) — nhả khi hết hạn/hủy, trừ hẳn khi PAID.\r\n  reservedStock Int             @default(0)\r\n  /// BE-6: ảnh sản phẩm (URL tuyệt đối hoặc đường dẫn tĩnh).\r\n  imageUrl      String?\r\n  /// Bộ ảnh phụ (ảnh đầu tiên trùng `imageUrl` nếu có).\r\n  imageUrls     String[]        @default([])\r\n  /// Số lượng tối đa của sản phẩm trong MỘT đơn.\r\n  maxPerOrder   Int             @default(10)\r\n  /// Số lượng tối đa MỘT người được đặt trong một ngày (giờ VN, không tính đơn hết hạn/đã hủy).\r\n  maxPerDay     Int             @default(20)\r\n  /// Ngưỡng cảnh báo sắp hết hàng (theo số có thể bán).\r\n  lowStockThreshold Int         @default(5)\r\n  rating        Decimal         @default(0) @db.Decimal(3, 2)\r\n  reviewCount   Int             @default(0)\r\n  isActive      Boolean         @default(true)\r\n  createdById   String\r\n  createdBy     User            @relation(\"ProductCreatedBy\", fields: [createdById], references: [id])\r\n  createdAt     DateTime        @default(now())\r\n  updatedAt     DateTime        @default(now()) @updatedAt\r\n\r\n  reviews       ProductReview[]\r\n  orderItems    OrderItem[]\r\n  cartItems     CartItem[]\r\n  inventoryTransactions InventoryTransaction[]\r\n}\r\n\r\n/// Đánh giá sản phẩm: chỉ cho dòng đơn (OrderItem) thuộc đơn COMPLETED, mỗi dòng tối đa 1 đánh giá.\r\n/// Đánh giá cũ (trước luồng mới) có `orderItemId = null`.\r\nmodel ProductReview {\r\n  id           String     @id @default(uuid())\r\n  productId    String\r\n  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)\r\n  userId       String\r\n  user         User       @relation(\"ProductReviewUser\", fields: [userId], references: [id], onDelete: Cascade)\r\n  orderItemId  String?    @unique\r\n  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)\r\n  rating       Int\r\n  comment      String?\r\n  /// Manager ẩn đánh giá (không hiển thị công khai, không tính điểm trung bình).\r\n  isHidden     Boolean    @default(false)\r\n  hiddenReason String?\r\n  hiddenById   String?\r\n  hiddenAt     DateTime?\r\n  createdAt    DateTime   @default(now())\r\n  updatedAt    DateTime   @default(now()) @updatedAt\r\n\r\n  @@index([productId, isHidden])\r\n  @@index([userId])\r\n}\r\n\r\n/// Giỏ hàng lưu ở server (một giỏ / người). Giỏ KHÔNG giữ tồn kho.\r\nmodel Cart {\r\n  id        String     @id @default(uuid())\r\n  userId    String     @unique\r\n  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  createdAt DateTime   @default(now())\r\n  updatedAt DateTime   @default(now()) @updatedAt\r\n\r\n  items     CartItem[]\r\n}\r\n\r\nmodel CartItem {\r\n  id                String   @id @default(uuid())\r\n  cartId            String\r\n  cart              Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)\r\n  productId         String\r\n  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)\r\n  quantity          Int\r\n  /// Giá lúc thêm vào giỏ — khác giá hiện tại ⇒ cảnh báo PRICE_CHANGED (giá thanh toán luôn do server tính).\r\n  unitPriceSnapshot Decimal  @db.Decimal(12, 2)\r\n  createdAt         DateTime @default(now())\r\n  updatedAt         DateTime @default(now()) @updatedAt\r\n\r\n  @@unique([cartId, productId])\r\n  @@index([productId])\r\n}\r\n\r\n/// Sổ địa chỉ giao hàng của người dùng (đơn DELIVERY lưu SNAPSHOT địa chỉ, không trỏ bảng này).\r\nmodel UserAddress {\r\n  id            String   @id @default(uuid())\r\n  userId        String\r\n  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)\r\n  recipientName String\r\n  phone         String\r\n  province      String\r\n  /// Không bắt buộc: địa giới 2 cấp (Tỉnh → Phường/Xã) không còn Quận/Huyện.\r\n  district      String?\r\n  ward          String?\r\n  street        String\r\n  isDefault     Boolean  @default(false)\r\n  createdAt     DateTime @default(now())\r\n  updatedAt     DateTime @default(now()) @updatedAt\r\n\r\n  @@index([userId])\r\n}\r\n\r\nenum FulfillmentType {\r\n  PICKUP // Nhận tại quầy trung tâm (mã nhận hàng)\r\n  DELIVERY // Giao tận nơi (mã vận đơn)\r\n}\r\n\r\nmodel Order {\r\n  id          String      @id @default(uuid())\r\n  /// Mã đơn dễ đọc, duy nhất (VD DH241011-7KQ3XM) — KHÁC mã chuyển khoản SePay (`Payment.transactionCode`).\r\n  code        String      @unique\r\n  userId      String\r\n  user        User        @relation(\"OrderUser\", fields: [userId], references: [id])\r\n  fulfillmentType FulfillmentType @default(PICKUP)\r\n  /// Tạm tính = Σ `OrderItem.totalAmount` (server tính).\r\n  subtotal    Decimal     @db.Decimal(12, 2)\r\n  shippingFee Decimal     @default(0) @db.Decimal(12, 2)\r\n  /// Tổng phải trả = subtotal + shippingFee — cũng là số tiền của Payment / mã QR.\r\n  totalPrice  Decimal     @db.Decimal(12, 2)\r\n  status      OrderStatus @default(PENDING_PAYMENT)\r\n  /// Snapshot người nhận (cả PICKUP — đối chiếu 4 số cuối SĐT khi nhận hàng).\r\n  recipientName    String?\r\n  recipientPhone   String?\r\n  /// Snapshot địa chỉ giao (DELIVERY).\r\n  shippingAddress  String?\r\n  shippingProvince String?\r\n  note        String?\r\n  /// Hạn chuyển khoản; quá hạn ⇒ job chuyển EXPIRED + nhả hàng.\r\n  paymentExpiresAt DateTime?\r\n  /// Mã nhận hàng (PICKUP, sinh khi READY_FOR_PICKUP): chỉ lưu SHA-256; mã hiển thị = HMAC(secret, id:nonce).\r\n  pickupCodeHash       String?  @unique\r\n  pickupCodeNonce      String?\r\n  pickupDeadline       DateTime?\r\n  pickupFailedAttempts Int      @default(0)\r\n  pickupLockedUntil    DateTime?\r\n  trackingCode String?\r\n  carrier      String?\r\n  /// BE-21: lý do đơn bị hủy (null khi chưa hủy).\r\n  cancelReason OrderCancelReason?\r\n  cancelNote   String?\r\n  cancelledById String?\r\n  /// Chống tạo đơn trùng (header Idempotency-Key) — `idempotencyHash` = hash nội dung request.\r\n  idempotencyKey  String?\r\n  idempotencyHash String?\r\n  paidAt        DateTime?\r\n  processingAt  DateTime?\r\n  readyAt       DateTime?\r\n  shippedAt     DateTime?\r\n  deliveredAt   DateTime?\r\n  completedAt   DateTime?\r\n  cancelledAt   DateTime?\r\n  expiredAt     DateTime?\r\n  notPickedUpAt DateTime?\r\n  refundedAt    DateTime?\r\n  createdAt   DateTime    @default(now())\r\n  updatedAt   DateTime    @default(now()) @updatedAt\r\n\r\n  /// Các dòng hàng của đơn (một đơn có thể mua nhiều sản phẩm).\r\n  items       OrderItem[]\r\n  /// Giao dịch thanh toán của đơn (SePay). PENDING = đang giữ hàng chờ chuyển khoản.\r\n  payment     Payment?\r\n  history     OrderStatusHistory[]\r\n  refunds     Refund[]\r\n  inventoryTransactions InventoryTransaction[]\r\n\r\n  @@unique([userId, idempotencyKey])\r\n  @@index([userId, status])\r\n  @@index([status, paymentExpiresAt])\r\n  @@index([status, pickupDeadline])\r\n  @@index([createdAt])\r\n}\r\n\r\nmodel OrderItem {\r\n  id          String   @id @default(uuid())\r\n  orderId     String\r\n  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)\r\n  productId   String\r\n  product     Product  @relation(fields: [productId], references: [id])\r\n  /// Snapshot tên/ảnh sản phẩm lúc đặt.\r\n  productName     String?\r\n  productImageUrl String?\r\n  quantity    Int\r\n  /// Đơn giá tại thời điểm đặt (snapshot — đổi giá sản phẩm sau này không ảnh hưởng đơn cũ).\r\n  unitPrice   Decimal  @db.Decimal(12, 2)\r\n  /// Thành tiền của dòng = quantity × unitPrice.\r\n  totalAmount Decimal  @db.Decimal(12, 2)\r\n  createdAt   DateTime @default(now())\r\n  updatedAt   DateTime @default(now()) @updatedAt\r\n\r\n  review      ProductReview?\r\n\r\n  @@unique([orderId, productId])\r\n  @@index([productId])\r\n}\r\n\r\n/// Lịch sử chuyển trạng thái đơn (actorId null = hệ thống: webhook, job).\r\nmodel OrderStatusHistory {\r\n  id         String       @id @default(uuid())\r\n  orderId    String\r\n  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)\r\n  fromStatus OrderStatus?\r\n  toStatus   OrderStatus\r\n  actorId    String?\r\n  reason     String?\r\n  createdAt  DateTime     @default(now())\r\n  updatedAt  DateTime     @default(now()) @updatedAt\r\n\r\n  @@index([orderId, createdAt])\r\n}\r\n\r\nenum InventoryTransactionType {\r\n  IN // Nhập hàng (+stock)\r\n  RESERVE // Giữ hàng khi tạo đơn (+reserved)\r\n  RELEASE // Nhả hàng khi đơn hết hạn/hủy trước khi thanh toán (−reserved)\r\n  SALE // Thanh toán thành công: hàng thuộc khách (−stock, −reserved)\r\n  RETURN // Hoàn tiền đơn đã thanh toán mà hàng còn ở trung tâm (+stock)\r\n  ADJUST // Điều chỉnh kiểm kê/hư hỏng (±stock)\r\n}\r\n\r\n/// Nhật ký kho bất biến — mọi thay đổi `stockQuantity` / `reservedStock` đều có một dòng.\r\nmodel InventoryTransaction {\r\n  id            String                   @id @default(uuid())\r\n  productId     String\r\n  product       Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)\r\n  type          InventoryTransactionType\r\n  /// Số lượng (dương); riêng ADJUST có thể âm.\r\n  quantity      Int\r\n  stockAfter    Int\r\n  reservedAfter Int\r\n  orderId       String?\r\n  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)\r\n  actorId       String?\r\n  note          String?\r\n  createdAt     DateTime                 @default(now())\r\n  updatedAt     DateTime                 @default(now()) @updatedAt\r\n\r\n  @@index([productId, createdAt])\r\n  @@index([orderId])\r\n}\r\n\r\n/// Ai/điều gì hủy đơn: người mua, hết hạn chờ chuyển khoản, hay Manager (BE-21).\r\nenum OrderCancelReason {\r\n  BUYER\r\n  EXPIRED\r\n  MANAGER\r\n}\r\n\r\n/// Xem máy trạng thái ở Doc/SHOP_FLOW_DESIGN.md §3.\r\nenum OrderStatus {\r\n  PENDING_PAYMENT\r\n  PAID\r\n  PROCESSING\r\n  READY_FOR_PICKUP\r\n  SHIPPING\r\n  DELIVERED\r\n  COMPLETED\r\n  EXPIRED\r\n  CANCELLED\r\n  NOT_PICKED_UP\r\n  REFUND_REQUESTED\r\n  REFUNDED\r\n}\r\n\r\n// ── Gói thành viên (tập gym tự do, không qua lớp/HLV) ────────────────────────\r\n\r\n/// Gói thành viên theo thời gian do Manager cấu hình.\r\nmodel MembershipPlan {\r\n  id           String       @id @default(uuid())\r\n  /// VD: \"Gói 1 tháng\", \"Gói 3 tháng\".\r\n  name         String\r\n  /// Số ngày hiệu lực (30, 90, 180…).\r\n  durationDays Int\r\n  price        Decimal      @db.Decimal(12, 2)\r\n  description  String?\r\n  /// Manager bật/tắt gói (gói tắt không bán nữa, membership đã mua vẫn giữ).\r\n  isActive     Boolean      @default(true)\r\n  createdAt    DateTime     @default(now())\r\n  updatedAt    DateTime     @default(now()) @updatedAt\r\n  memberships  Membership[]\r\n}\r\n\r\n/// Một lần mua gói thành viên — tạo khi SePay xác nhận đã thu tiền.\r\n/// Mua tiếp khi còn hạn ⇒ gói mới bắt đầu ngay sau ngày hết hạn gói hiện tại (cộng dồn).\r\nmodel Membership {\r\n  id        String           @id @default(uuid())\r\n  memberId  String\r\n  member    MemberProfile    @relation(fields: [memberId], references: [id], onDelete: Cascade)\r\n  planId    String\r\n  plan      MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)\r\n  paymentId String?          @unique\r\n  payment   Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)\r\n  startDate DateTime\r\n  endDate   DateTime\r\n  status    MembershipStatus @default(ACTIVE)\r\n  createdAt DateTime         @default(now())\r\n  updatedAt DateTime         @default(now()) @updatedAt\r\n\r\n  @@index([memberId])\r\n  @@index([status])\r\n}\r\n\r\nenum MembershipStatus {\r\n  ACTIVE\r\n  EXPIRED\r\n  CANCELLED\r\n}\r\n
