           <p>Đường dẫn này không thuộc khu vực quản trị.</p>\r\n                    <Link className=\"cr-btn primary\" to=\"/manager/dashboard\">\r\n                      Về tổng quan\r\n                    </Link>\r\n                  </div>\r\n                }\r\n              />\r\n            </Routes>\r\n          </Suspense>\r\n        </main>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n
