te-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; }\r\n.cr-kpi {\r\n  position: relative; padding: 18px 20px; display: grid; gap: 6px; align-content: start; min-width: 0;\r\n  background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); box-shadow: var(--shadow-card);\r\n}\r\na.cr-kpi { transition: border-color var(--t) var(--ease), box-shadow var(--t) var(--ease); }\r\na.cr-kpi:hover { border-color: color-mix(in srgb, var(--primary) 35%, var(--border)); box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06); }\r\n.cr-kpi-value { order: -1; font-size: 28px; font-weight: 650; line-height: 1.2; letter-spacing: -0.025em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; color: var(--text); padding-right: 44px; }\r\n.cr-kpi-label { color: var(--text-2); font-size: 13.5px; font-weight: 500; display: flex; align-items: center; gap: 6px; }\r\n.cr-kpi-label > svg { color: var(--text-muted); }\r\n.cr-kpi-note { color: var(--text-3); font-size: 12.5px; }\r\n.cr-kpi-icon { position: absolute; top: 16px; right: 16px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--primary-subtle); color: var(--primary); }\r\n.cr-kpi-icon.warn { background: var(--warning-soft); color: var(--warning-text); }\r\n.cr-kpi-meter { height: 6px; border-radius: var(--r-full); background: var(--surface-hover); overflow: hidden; margin-top: 10px; }\r\n.cr-kpi-meter i { display: block; height: 100%; border-radius: inherit; background: var(--primary); transition: width 0.4s var(--ease); }\r\n.cr-kpi.attention .cr-kpi-label::after, .cr-kpi.alert .cr-kpi-label::after { content: \"\"; width: 7px; height: 7px; border-radius: 50%; background: var(--warning); margin-left: 2px; }\r\n.cr-kpi.alert .cr-kpi-label::after { background: var(--danger); }\r\n\r\n/* ── Toolbar / filters ─────────────────────────────── */\r\n.cr-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 16px 18px 6px; }\r\n.cr-toolbar .cr-search { flex: 1 1 240px; max-width: 360px; }\r\n.cr-toolbar .cr-field { flex: 0 1 190px; }\r\n.cr-toolbar .cr-field > span:first-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }\r\n.cr-toolbar-spacer { flex: 1; }\r\n.cr-filters { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }\r\n.cr-filters > * { flex: 1 1 128px; max-width: 220px; }\r\n.cr-filters .cr-search { flex: 2 1 180px; max-width: 340px; }\r\n.cr-filters .cr-btn { flex: 0 0 auto; }\r\n\r\n/* ── Data table — hàng nền xám nhẹ, bo góc, không kẻ lưới ── */\r\n.cr-table-wrap { position: relative; overflow-x: auto; scrollbar-width: thin; padding: 0 12px 6px; }\r\n.cr-table-wrap:focus-visible { outline-offset: -2px; border-radius: var(--r); }\r\n.cr-table-wrap::-webkit-scrollbar { display: block; height: 8px; }\r\n.cr-table-wrap::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }\r\n.cr-panel:not(.flush) > .cr-table-wrap, .cr-table-wrap.boxed { padding: 0; margin: 0 -8px; }\r\n.cr-table { width: 100%; border-collapse: separate; border-spacing: 0 6px; min-width: 640px; font-size: 13.5px; white-space: normal; }\r\n.cr .cr-table th {\r\n  text-align: left; font-size: 12.5px; font-weight: 500; color: var(--text-3); padding: 6px 14px 2px; height: 34px;\r\n  background: none; border: 0; white-space: nowrap; text-transform: none; letter-spacing: 0;\r\n}\r\n.cr .cr-table td {\r\n  padding: 10px 14px; height: 54px; border: 0; vertical-align: middle; color: var(--text);\r\n  max-width: none; min-width: 0; overflow: visible; white-space: normal; overflow-wrap: normal; background: var(--row); font-size: 13.5px;\r\n  transition: background 0.12s var(--ease);\r\n}\r\n.cr .cr-table td:first-child { border-radius: var(--r) 0 0 var(--r); }\r\n.cr .cr-table td:last-child { border-radius: 0 var(--r) var(--r) 0; }\r\n.cr .cr-table tbody tr:hover td { background: var(--row-hover); }\r\n.cr .cr-table tbody tr.selected td { background: var(--selected); }\r\n.cr .cr-table .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }\r\n.cr .cr-table .actions { text-align: right; white-space: nowrap; width: 1%; }\r\n.cr .cr-table .nowrap { white-space: nowrap; }\r\n.cr .cr-table tr.clickable { cursor: pointer; }\r\n.cr-cell-main { display: grid; gap: 1px; min-width: 160px; }\r\n.cr-cell-main a, .cr-cell-main strong { font-weight: 500; color: var(--text); }\r\n.cr-cell-main a:hover { color: var(--primary-text); }\r\n.cr-cell-main small { color: var(--text-3); font-size: 12.5px; }\r\n.cr-cell-media { display: flex; align-items: center; gap: 12px; min-width: 0; }\r\n.cr-row-actions { display: inline-flex; gap: 2px; justify-content: flex-end; }\r\n.cr-pager { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 10px 18px 14px; color: var(--text-3); font-size: 13px; font-variant-numeric: tabular-nums; }\r\n.cr-panel:not(.flush) > .cr-pager { padding: 10px 0 0; }\r\n.cr-pager-btns { display: flex; gap: 6px; align-items: center; }\r\n.cr-pager-btns b { font-weight: 500; color: var(--text); padding: 0 8px; }\r\n\r\n/* Vòng tỷ lệ (sĩ số / sức chứa) */\r\n.cr-ring { position: relative; display: inline-flex; align-items: center; gap: 8px; font-variant-numeric: tabular-nums; font-size: 13px; color: var(--text); white-space: nowrap; }\r\n.cr-ring svg { flex: none; transform: rotate(-90deg); }\r\n.cr-ring .track { stroke: var(--border-strong); }\r\n.cr-ring .val { stroke: var(--primary); transition: stroke-dasharray 0.4s var(--ease); }\r\n.cr-ring.full .val { stroke: var(--warning); }\r\n\r\n/* ── Status ────────────────────────────────────────── */\r\n.cr-pill {\r\n  display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 10px 0 8px; border-radius: var(--r-full);\r\n  font-size: 12.5px; font-weight: 500; white-space: nowrap; line-height: 1; background: var(--neutral-soft); color: var(--text-2);\r\n}\r\n.cr-pill::before { content: \"\"; width: 6px; height: 6px; border-radius: 50%; background: var(--neutral); flex: none; }\r\n.cr-pill.ok { background: var(--success-soft); color: var(--success-text); } .cr-pill.ok::before { background: var(--success); }\r\n.cr-pill.warn { background: var(--warning-soft); color: var(--warning-text); } .cr-pill.warn::before { background: var(--warning); }\r\n.cr-pill.bad { background: var(--danger-soft); color: var(--danger-text); } .cr-pill.bad::before { background: var(--danger); }\r\n.cr-pill.info { background: var(--info-soft); color: var(--info-text); } .cr-pill.info::before { background: var(--info); }\r\n.cr-pill.plain { padding: 0 10px; } .cr-pill.plain::before { display: none; }\r\n/* Tag: dùng hiếm (vai trò, nhãn ngữ cảnh) */\r\n.cr-tag { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: var(--r-xs); font-size: 12px; font-weight: 500; background: var(--surface-2); color: var(--text-2); border: 1px solid var(--border); white-space: nowrap; }\r\n.cr-tag.warn { background: var(--warning-soft); color: var(--warning-text); border-color: transparent; }\r\n.cr-tag.info { background: var(--info-soft); color: var(--info-text); border-color: transparent; }\r\n.cr-tag.bad { background: var(--danger-soft); color: var(--danger-text); border-color: transparent; }\r\n.cr-tag.ok { background: var(--success-soft); color: var(--success-text); border-color: transparent; }\r\n\r\n/* ── Detail lists ──────────────────────────────────── */\r\n.cr-dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 22px; margin: 0; }\r\n.cr-dl div { min-width: 0; }\r\n.cr-dl dt { color: var(--text-3); font-size: 12.5px; margin-bottom: 3px; }\r\n.cr-dl dd { margin: 0; overflow-wrap: anywhere; color: var(--text); font-variant-numeric: tabular-nums; font-weight: 500; }\r\n.cr-dl a, .cr p a, .cr-alert a { color: var(--primary-text); }\r\n.cr-desc { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); }\r\n.cr-desc span { display: block; color: var(--text-3); font-size: 12.5px; margin-bottom: 4px; }\r\n.cr-desc p { margin: 0; white-space: pre-wrap; color: var(--text-2); }\r\n.cr-dl dd .cr-cell-main small { display: block; color: var(--text-3); font-weight: 400; font-size: 12.5px; overflow-wrap: anywhere; }\r\n.cr-dl a:hover, .cr p a:hover { text-decoration: underline; }\r\n.cr-rows { display: grid; margin: 0; }\r\n.cr-rows > div { display: flex; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--border); font-size: 14px; }\r\n.cr-rows > div:last-child { border-bottom: 0; }\r\n.cr-rows dt { color: var(--text-2); }\r\n.cr-rows dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; font-weight: 500; }\r\n.cr-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); overflow-x: auto; }\r\n.cr-tabs button { background: none; border: 0; color: var(--text-2); padding: 10px 14px; font-weight: 500; font-size: 14px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; transition: color var(--t), border-color var(--t); }\r\n.cr-tabs button:hover { color: var(--text); }\r\n.cr-tabs button[aria-selected=\"true\"] { color: var(--primary-text); border-bottom-color: var(--primary); font-weight: 600; }\r\n.cr-list { display: grid; margin: 0; padding: 0; list-style: none; gap: 6px; }\r\n.cr-list li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 12px; border-radius: var(--r); background: var(--row); }\r\n.cr-list li > div { min-width: 0; }\r\n\r\n/* ── Feedback ──────────────────────────────────────── */\r\n.cr-state { display: grid; justify-items: center; text-align: center; gap: 6px; padding: 40px 16px; color: var(--text-2); }\r\n.cr-state h3 { margin: 4px 0 0; font-size: 15px; font-weight: 600; }\r\n.cr-state p { margin: 0; max-width: 46ch; font-size: 13.5px; color: var(--text-3); }\r\n.cr-state > svg { color: var(--text-muted); }\r\n.cr-state-icon { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-2); color: var(--text-muted); margin-bottom: 2px; }\r\n.cr-alert { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: var(--r); background: var(--danger-soft); color: var(--text); font-size: 13.5px; border: 1px solid color-mix(in srgb, var(--danger) 22%, transparent); }\r\n.cr-alert > svg { color: var(--danger); flex: none; margin-top: 2px; }\r\n.cr-alert.info { background: var(--primary-subtle); border-color: color-mix(in srgb, var(--primary) 18%, transparent); }\r\n.cr-alert.info > svg { color: var(--primary); }\r\n.cr-alert.warn { background: var(--warning-soft); border-color: color-mix(in srgb, var(--warning) 25%, transparent); }\r\n.cr-alert.warn > svg { color: var(--warning-text); }\r\n.cr-alert strong { display: block; font-weight: 600; }\r\n.cr-alert p { margin: 2px 0 0; color: var(--text-2); }\r\n.cr-alert > div { min-width: 0; flex: 1; overflow-wrap: anywhere; }\r\n.cr-note { color: var(--text-3); font-size: 12.5px; margin: 0; line-height: 1.5; }\r\n.cr-skel { display: grid; gap: 10px; padding: 12px 0; }\r\n.cr-panel.flush .cr-skel { padding: 12px 18px 18px; }\r\n.cr-skel span { height: 14px; border-radius: 6px; background: linear-gradient(90deg, var(--surface-hover), var(--surface-2), var(--surface-hover)); background-size: 200% 100%; animation: cr-shimmer 1.4s ease-in-out infinite; }\r\n@keyframes cr-shimmer { to { background-position: -200% 0; } }\r\n\r\n/* ── Dialog ────────────────────────────────────────── */\r\n.cr-modal {\r\n  width: min(560px, calc(100vw - 32px)); max-height: calc(100vh - 48px); padding: 0; border-radius: 16px;\r\n  border: 1px solid var(--border); background: var(--surface); color: var(--text); box-shadow: var(--shadow-pop);\r\n  font-family: var(--font); font-size: 14px;\r\n}\r\n.cr-modal[open] { animation: cr-dialog 0.18s var(--ease); }\r\n.cr-modal.wide { width: min(780px, calc(100vw - 32px)); }\r\n.cr-modal::backdrop { background: var(--overlay); backdrop-filter: blur(2px); }\r\n.cr-modal-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 20px 22px 0; }\r\n.cr-modal-head h2 { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.4; }\r\n.cr-modal-head p { margin: 2px 0 0; color: var(--text-3); font-size: 13px; }\r\n.cr-modal-body { padding: 18px 22px; display: grid; gap: 16px; }\r\n.cr-modal-foot { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 22px; border-top: 1px solid var(--border); background: var(--surface-2); flex-wrap: wrap; border-radius: 0 0 16px 16px; }\r\n@keyframes cr-dialog { from { opacity: 0; transform: translateY(8px) scale(0.99); } to { opacity: 1; transform: none; } }\r\n.cr-confirm-target { padding: 11px 14px; border-radius: var(--r); background: var(--surface-2); border: 1px solid var(--border); }\r\n.cr-confirm-target small { display: block; color: var(--text-3); font-size: 12px; }\r\n.cr-confirm-target strong { font-weight: 600; }\r\n\r\n/* ── Bars (phân bổ) ────────────────────────────────── */\r\n.cr-bars { display: grid; gap: 14px; }\r\n.cr-bar-row { display: grid; grid-template-columns: minmax(110px, 0.9fr) minmax(0, 2fr) auto; gap: 14px; align-items: center; font-size: 13.5px; }\r\n.cr-bar-row > span:first-child { color: var(--text-2); }\r\n.cr-bar-row > span:last-child { font-variant-numeric: tabular-nums; text-align: right; min-width: 70px; font-weight: 500; }\r\n.cr-bar-track { height: 8px; border-radius: var(--r-full); background: var(--surface-hover); overflow: hidden; }\r\n.cr-bar-fill { height: 100%; background: var(--primary); border-radius: inherit; transition: width 0.3s var(--ease); }\r\n.cr-bar-fill.alt { background: var(--chart-2); }\r\n.cr-bar-fill.neg { background: var(--danger); }\r\n\r\n/* ── Column chart (dashboard) ──────────────────────── */\r\n.cr-chart { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 12px; }\r\n.cr-chart-axis { display: flex; flex-direction: column; justify-content: space-between; height: 220px; font-size: 12px; color: var(--text-3); text-align: right; font-variant-numeric: tabular-nums; transform: translateY(-7px); }\r\n.cr-chart-plot { position: relative; height: 220px; display: grid; grid-template-columns: repeat(var(--n, 7), minmax(0, 1fr)); align-items: end;\r\n  background-image: linear-gradient(to bottom, var(--chart-grid) 1px, transparent 1px); background-size: 100% 25%; border-bottom: 1px solid var(--border-strong); }\r\n.cr-chart-col { position: relative; height: 100%; display: flex; align-items: flex-end; justify-content: center; gap: 4px; cursor: default; outline: none; }\r\n.cr-chart-col:focus-visible { box-shadow: inset 0 0 0 2px var(--focus); border-radius: var(--r-sm); }\r\n.cr-chart-col:hover, .cr-chart-col:focus-visible { background: color-mix(in srgb, var(--primary) 5%, transparent); border-radius: var(--r-sm) var(--r-sm) 0 0; }\r\n.cr-chart-bar { width: min(22px, 32%); border-radius: 6px 6px 0 0; min-height: 2px; transition: height 0.45s var(--ease); }\r\n.cr-chart-bar.cur { background: var(--chart-1); }\r\n.cr-chart-bar.prev { background: repeating-linear-gradient(135deg, var(--chart-2) 0 3px, color-mix(in srgb, var(--chart-2) 62%, var(--surface)) 3px 6px); }\r\n.cr-chart-bar.zero { opacity: 0.35; }\r\n.cr-chart-x { grid-column: 2; display: grid; grid-template-columns: repeat(var(--n, 7), minmax(0, 1fr)); font-size: 12px; color: var(--text-3); text-align: center; padding-top: 8px; }\r\n.cr-chart-x b { display: block; font-weight: 500; color: var(--text-2); }\r\n.cr-chart-x .today b { color: var(--primary-text); font-weight: 600; }\r\n.cr-chart-tip {\r\n  position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%); z-index: 3; pointer-events: none; min-width: 168px;\r\n  background: var(--text); color: var(--surface); border-radius: var(--r); padding: 8px 10px; font-size: 12px; line-height: 1.5; box-shadow: var(--shadow-pop);\r\n  opacity: 0; transition: opacity 0.12s var(--ease); white-space: nowrap;\r\n}\r\n.cr-chart-tip::after { content: \"\"; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); border: 5px solid transparent; border-top-color: var(--text); }\r\n.cr-chart-tip b { font-weight: 600; display: block; margin-bottom: 2px; }\r\n.cr-chart-tip span { display: flex; align-items: center; gap: 6px; justify-content: space-between; }\r\n.cr-chart-tip i { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }\r\n.cr-chart-col:hover .cr-chart-tip, .cr-chart-col:focus-visible .cr-chart-tip { opacity: 1; }\r\n.cr-chart-col:first-child .cr-chart-tip { left: 0; transform: none; }\r\n.cr-chart-col:first-child .cr-chart-tip::after { left: 18px; }\r\n.cr-chart-col:last-child .cr-chart-tip { left: auto; right: 0; transform: none; }\r\n.cr-chart-col:last-child .cr-chart-tip::after { left: auto; right: 14px; transform: none; }\r\n.cr-chart-sum { display: flex; gap: 28px; flex-wrap: wrap; margin-bottom: 18px; }\r\n.cr-chart-sum div { display: grid; gap: 2px; }\r\n.cr-chart-sum small { color: var(--text-3); font-size: 12.5px; display: inline-flex; align-items: center; gap: 6px; }\r\n.cr-chart-sum strong { font-size: 20px; font-weight: 650; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }\r\n.cr-delta { font-size: 12.5px; font-weight: 600; padding: 2px 8px; border-radius: var(--r-full); background: var(--neutral-soft); color: var(--text-2); align-self: end; margin-bottom: 3px; font-variant-numeric: tabular-nums; }\r\n.cr-delta.up { background: var(--success-soft); color: var(--success-text); }\r\n.cr-delta.down { background: var(--danger-soft); color: var(--danger-text); }\r\n.cr-legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 12.5px; color: var(--text-2); align-items: center; }\r\n.cr-legend span { display: inline-flex; align-items: center; gap: 6px; }\r\n.cr-legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }\r\n.cr-legend i.cur { background: var(--chart-1); }\r\n.cr-legend i.prev { background: repeating-linear-gradient(135deg, var(--chart-2) 0 2px, color-mix(in srgb, var(--chart-2) 55%, var(--surface)) 2px 4px); }\r\n\r\n/* ── Mini month calendar (dashboard) ───────────────── */\r\n.cr-cal-head { display: flex; align-items: center; gap: 4px; }\r\n.cr-cal-head strong { font-size: 14px; font-weight: 600; min-width: 112px; text-align: center; font-variant-numeric: tabular-nums; }\r\n.cr-cal { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px 0; text-align: center; }\r\n.cr-cal-dow { font-size: 12px; color: var(--text-3); font-weight: 500; padding-bottom: 8px; }\r\n.cr-cal-day {\r\n  position: relative; height: 40px; display: grid; place-items: center; border: 0; background: none; cursor: pointer; font: inherit;\r\n  font-size: 13px; color: var(--text); font-variant-numeric: tabular-nums; padding: 0;\r\n}\r\n.cr-cal-day > span { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; transition: background var(--t), color var(--t); }\r\n.cr-cal-day:hover > span { background: var(--surface-hover); }\r\n.cr-cal-day.muted { color: var(--text-muted); }\r\n.cr-cal-day.has > span { background: var(--primary-subtle); color: var(--primary-text); font-weight: 600; }\r\n.cr-cal-day.today > span { box-shadow: inset 0 0 0 1.5px var(--primary); }\r\n.cr-cal-day[aria-pressed=\"true\"] > span { background: var(--primary); color: var(--primary-fg); font-weight: 600; }\r\n.cr-cal-day i { position: absolute; bottom: 1px; left: 50%; transform: translateX(-50%); display: flex; gap: 2px; }\r\n.cr-cal-day i b { width: 4px; height: 4px; border-radius: 50%; background: var(--primary); }\r\n.cr-cal-day.cancel i b:last-child { background: var(--danger); }\r\n.cr-cal-foot { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 12.5px; color: var(--text-3); }\r\n\r\n/* Hàng chờ xử lý */\r\n.cr-queue-foot { display: grid; gap: 6px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }\r\n.cr-queue-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 13.5px; color: var(--text-2); }\r\n.cr-queue-row b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }\r\n.cr-queue-row a { color: var(--primary-text); font-weight: 500; }\r\n.cr-queue-row a:hover { text-decoration: underline; }\r\n.cr-time { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text); white-space: nowrap; }\r\n.cr-time small { display: block; font-weight: 500; color: var(--text-3); font-size: 12px; }\r\n\r\n/* ── Week calendar ─────────────────────────────────── */\r\n.cr-week { display: grid; grid-template-columns: repeat(7, minmax(130px, 1fr)); border: 1px solid var(--border); border-radius: var(--r-lg); overflow-x: auto; background: var(--surface); }\r\n.cr-day { min-height: 240px; display: flex; flex-direction: column; border-right: 1px solid var(--border); min-width: 0; }\r\n.cr-day:last-child { border-right: 0; }\r\n.cr-day-head { padding: 10px 12px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: baseline; background: var(--surface-2); }\r\n.cr-day-head strong { font-weight: 500; font-size: 13px; color: var(--text-2); }\r\n.cr-day-head span { color: var(--text-3); font-size: 12.5px; font-variant-numeric: tabular-nums; }\r\n.cr-day.today .cr-day-head { background: var(--primary-subtle); box-shadow: inset 0 -2px 0 var(--primary); }\r\n.cr-day.today .cr-day-head strong, .cr-day.today .cr-day-head span { color: var(--primary-text); font-weight: 600; }\r\n.cr-day-body { padding: 8px; display: grid; gap: 6px; align-content: start; }\r\n.cr-event {\r\n  text-align: left; border: 0; border-left: 3px solid var(--primary); border-radius: var(--r-sm); background: var(--primary-subtle);\r\n  color: var(--text); padding: 7px 9px; font: inherit; font-size: 12.5px; cursor: pointer; display: grid; gap: 1px; transition: background 0.12s;\r\n}\r\n.cr-event:hover { background: var(--primary-soft); }\r\n.cr-event b { font-weight: 600; font-size: 12px; color: var(--primary-text); font-variant-numeric: tabular-nums; }\r\n.cr-event span { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.cr-event small { font-size: 12px; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.cr-event.CANCELLED { border-left-color: var(--danger); background: var(--danger-soft); opacity: 0.8; }\r\n.cr-event.CANCELLED b { color: var(--danger-text); }\r\n.cr-event.CANCELLED span { text-decoration: line-through; }\r\n.cr-event.COMPLETED { border-left-color: var(--neutral); background: var(--surface-2); }\r\n.cr-event.COMPLETED b { color: var(--text-2); }\r\n.cr-event.makeup { border-left-color: var(--warning); background: var(--warning-soft); }\r\n.cr-event.makeup b { color: var(--warning-text); }\r\n.cr-day-empty { color: var(--text-3); font-size: 12px; text-align: center; padding: 16px 0; }\r\n\r\n.cr-seg { display: inline-flex; padding: 3px; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface-2); gap: 2px; }\r\n.cr-seg button { background: transparent; border: 0; color: var(--text-2); padding: 0 12px; height: 30px; font-weight: 500; font-size: 13px; cursor: pointer; border-radius: var(--r-sm); white-space: nowrap; transition: background var(--t), color var(--t); }\r\n.cr-seg button:hover { color: var(--text); }\r\n.cr-seg button[aria-pressed=\"true\"], .cr-seg button[aria-selected=\"true\"] { background: var(--surface); color: var(--primary-text); box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border); font-weight: 600; }\r\n\r\n/* Thumbnail sản phẩm */\r\n.cr-thumb { flex: none; border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--surface); object-fit: cover; display: grid; place-items: center; color: var(--text-muted); overflow: hidden; }\r\n.cr-frame { width: 100%; height: 520px; border: 1px solid var(--border); border-radius: var(--r); background: #fff; }\r\n\r\n/* ── Public screens (login / reset) ────────────────── */\r\n.cr.cr-solo { display: block; }\r\n.cr-auth { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }\r\n.cr-auth-story {\r\n  position: relative; overflow: hidden; padding: 40px 48px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px;\r\n  background: #1e3a8a; color: #e0e7ff; isolation: isolate;\r\n}\r\n.cr-auth-story .cr-brand { border: 0; margin: 0; padding: 0; min-height: 0; }\r\n.cr-auth-story .cr-brand-mark { background: #ffffff; color: #1d4ed8; }\r\n.cr-auth-story .cr-brand-name, .cr-auth-story h1 { color: #ffffff; }\r\n.cr-auth-story .cr-brand-name small, .cr-auth-story .cr-eyebrow { color: #bfdbfe; }\r\n.cr-auth-story h1 { font-size: clamp(28px, 3vw, 40px); line-height: 1.18; font-weight: 650; letter-spacing: -0.028em; margin: 10px 0 14px; max-width: 18ch; }\r\n.cr-auth-story h1 em { font-style: normal; color: #93c5fd; }\r\n.cr-auth-story p { color: #c7d2fe; max-width: 46ch; font-size: 15px; margin: 0; }\r\n.cr-auth-story .cr-mono { color: #a5b4fc !important; }\r\n/* Nền video tập tạ — tầng media nghiêng 3D theo con trỏ, chữ nổi phía trước */\r\n.cr-auth-story { perspective: 1200px; background: #0b1a4a; }\r\n.cr-auth-story > :not(.cr-auth-stage) { position: relative; z-index: 2; transform: translate3d(var(--mx, 0px), var(--my, 0px), 0); transition: transform 0.5s cubic-bezier(.2,.7,.2,1); }\r\n.cr-auth-stage { position: absolute; inset: -4%; z-index: 0; transform-style: preserve-3d;\r\n  transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(1.06); transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }\r\n.cr-auth-media { position: absolute; inset: 0; overflow: hidden; animation: cr-auth-drift 22s ease-in-out infinite alternate; }\r\n.cr-auth-media video, .cr-auth-media img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) contrast(1.08); }\r\n.cr-auth-shade { position: absolute; inset: 0;\r\n  background:\r\n    linear-gradient(90deg, rgba(10, 25, 80, 0.92) 0%, rgba(20, 45, 140, 0.72) 45%, rgba(29, 78, 216, 0.35) 100%),\r\n    linear-gradient(0deg, rgba(8, 18, 60, 0.85) 0%, rgba(8, 18, 60, 0) 40%),\r\n    radial-gradient(60% 50% at 80% 20%, rgba(147, 197, 253, 0.28), transparent 70%);\r\n  mix-blend-mode: normal; }\r\n.cr-auth-shade::after { content: \"\"; position: absolute; inset: 0; background: rgba(37, 99, 235, 0.28); mix-blend-mode: color; }\r\n@keyframes cr-auth-drift { from { transform: scale(1) translate3d(0, 0, 0); } to { transform: scale(1.08) translate3d(-1.5%, -1%, 0); } }\r\n.cr-auth-form { display: grid; place-items: center; padding: 32px; background: var(--bg); }\r\n.cr-auth-card { width: min(400px, 100%); display: grid; gap: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 32px; box-shadow: var(--shadow-card); }\r\n.cr-auth-card h2 { font-size: 24px; font-weight: 650; margin: 0; letter-spacing: -0.02em; }\r\n.cr-auth-card > p { color: var(--text-2); margin: -8px 0 4px; }\r\n.cr-auth-card .cr-btn { height: 42px; }\r\n.cr-auth-foot { color: var(--text-3); font-size: 12.5px; }\r\n.cr-pass { position: relative; }\r\n.cr .cr-pass input { padding-right: 42px; }\r\n.cr-pass button { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); background: none; border: 0; color: var(--text-muted); width: 32px; height: 30px; cursor: pointer; border-radius: 6px; display: grid; place-items: center; }\r\n.cr-pass button:hover { color: var(--text); background: var(--surface-hover); }\r\n.cr-fullscreen { min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 24px; }\r\n.cr-fullscreen > div { display: grid; gap: 12px; justify-items: center; max-width: 440px; }\r\n.cr-fullscreen h1 { margin: 0; font-size: 22px; font-weight: 650; }\r\n.cr-fullscreen p { color: var(--text-2); margin: 0; }\r\n.cr-auth-theme { position: fixed; top: 16px; right: 16px; }\r\n\r\n/* ── Toast dùng chung (render ngoài .cr) ───────────── */\r\nbody:has(.cr) .toast-viewport { top: 84px; }\r\nbody:has(.cr) .toast-notice { font-family: \"Inter\", system-ui, sans-serif; border-radius: 12px; border: 1px solid #e5eaf1; border-left: 3px solid currentColor; box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12); background: #fff; }\r\nbody:has(.cr) .toast-notice strong { color: #111827; font-weight: 600; font-size: 14px; }\r\nbody:has(.cr) .toast-notice p { color: #475569; font-size: 13.5px; }\r\nbody:has(.cr) .toast-success { color: #16a34a; }\r\nbody:has(.cr) .toast-error { color: #dc2626; }\r\nbody:has(.cr) .toast-info { color: #2563eb; }\r\nhtml[data-theme=\"dark\"] body:has(.cr) .toast-notice { background: #1e293b; border-color: #334155; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5); }\r\nhtml[data-theme=\"dark\"] body:has(.cr) .toast-notice strong { color: #f8fafc; }\r\nhtml[data-theme=\"dark\"] body:has(.cr) .toast-notice p, html[data-theme=\"dark\"] body:has(.cr) .toast-notice button { color: #cbd5e1; }\r\nhtml[data-theme=\"dark\"] body:has(.cr) .toast-success { color: #4ade80; }\r\nhtml[data-theme=\"dark\"] body:has(.cr) .toast-error { color: #f87171; }\r\nhtml[data-theme=\"dark\"] body:has(.cr) .toast-info { color: #60a5fa; }\r\n\r\n/* Skip link */\r\n.cr .skip-link { position: absolute; left: 12px; top: -48px; z-index: 100; background: var(--surface); color: var(--text); padding: 8px 12px; border-radius: var(--r); border: 1px solid var(--border); }\r\n.cr .skip-link:focus { top: 12px; }\r\n\r\n/* ── Responsive ────────────────────────────────────── */\r\n@media (max-width: 1240px) {\r\n  .cr-grid-side { grid-template-columns: minmax(0, 1fr); }\r\n  .cr-content { padding: 4px 24px 48px; }\r\n  .cr-top { padding: 0 24px; }\r\n}\r\n@media (max-width: 1100px) and (min-width: 601px) {\r\n  .cr-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }\r\n}\r\n@media (max-width: 960px) {\r\n  .cr-grid-2 { grid-template-columns: minmax(0, 1fr); }\r\n  .cr-menu-trigger .cr-menu-name { display: none; }\r\n}\r\n@media (max-width: 900px) {\r\n  .cr, .cr.collapsed { grid-template-columns: minmax(0, 1fr); }\r\n  .cr-side, .cr.collapsed .cr-side { position: fixed; inset: 0 auto 0 0; width: 272px; z-index: 50; transform: translateX(-100%); visibility: hidden; transition: transform 0.2s var(--ease), visibility 0s linear 0.2s; box-shadow: none; padding: 0 14px 16px; }\r\n  .cr-side.open { transform: none; visibility: visible; box-shadow: var(--shadow-pop); transition: transform 0.2s var(--ease); }\r\n  .cr.collapsed .cr-nav a span, .cr.collapsed .cr-brand-name, .cr.collapsed .cr-side-link span { display: initial; }\r\n  .cr.collapsed .cr-today { display: grid; }\r\n  .cr.collapsed .cr-brand { justify-content: flex-start; padding-left: 20px; margin: 0 -14px 14px; }\r\n  .cr.collapsed .cr-nav-title { visibility: visible; height: auto; padding: 16px 12px 6px; }\r\n  .cr.collapsed .cr-nav a, .cr.collapsed .cr-side-link { justify-content: flex-start; padding: 0 12px; }\r\n  .cr-collapse-btn { display: none !important; }\r\n  .cr-scrim { position: fixed; inset: 0; background: var(--overlay); z-index: 40; border: 0; }\r\n  .cr-burger { display: grid !important; }\r\n  .cr-top { padding: 0 16px; height: 68px; gap: 8px; }\r\n  .cr-content { padding: 4px 16px 40px; }\r\n  .cr-auth { grid-template-columns: minmax(0, 1fr); }\r\n  .cr-auth-story { display: none; }\r\n}\r\n@media (max-width: 600px) {\r\n  .cr-form, .cr-dl { grid-template-columns: minmax(0, 1fr); }\r\n  .cr-filters > *, .cr-filters .cr-search, .cr-toolbar .cr-search, .cr-toolbar .cr-field { max-width: none; flex-basis: 100%; }\r\n  .cr-bar-row { grid-template-columns: minmax(0, 1fr) auto; }\r\n  .cr-bar-row .cr-bar-track { grid-column: 1 / -1; grid-row: 2; }\r\n  .cr-head h1 { font-size: 23px; }\r\n  .cr-top-sep, .cr-gsearch-box kbd { display: none; }\r\n  .cr-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\r\n  .cr-kpi { padding: 14px; }\r\n  .cr-kpi-value { font-size: 21px; padding-right: 0; }\r\n  .cr-kpi-icon { display: none; }\r\n  .cr-chart-axis, .cr-chart-plot { height: 180px; }\r\n  .cr-auth-card { padding: 24px 20px; }\r\n}\r\n@media (max-width: 400px) {\r\n  .cr-kpis { grid-template-columns: minmax(0, 1fr); }\r\n}\r\n@media (prefers-reduced-motion: reduce) {\r\n  .cr *, .cr *::before, .cr *::after { animation: none !important; transition: none !important; }\r\n}\r\n
