<+>@import url(\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\");\r\n\r\n/*\r\n * PULSE — Web Manager design system (Blue SaaS). Xem Doc/DESIGN_DNA.md.\r\n * Phạm vi `.cr` (không ảnh hưởng portal cũ). Theme qua `html[data-theme=\"light|dark\"]`\r\n * (gán trước khi render bởi script trong index.html ⇒ không nháy sai theme).\r\n * Component chỉ đọc token semantic bên dưới — không tự đặt mã màu.\r\n */\r\n\r\n/* ── Tokens: Light ─────────────────────────────────── */\r\n.cr {\r\n  /* Brand / primary */\r\n  --primary: #2563eb;\r\n  --primary-hover: #1d4ed8;\r\n  --primary-active: #1e40af;\r\n  --primary-soft: #dbeafe;\r\n  --primary-subtle: #eff6ff;\r\n  --primary-fg: #ffffff;\r\n  --primary-text: #1d4ed8;      /* chữ xanh trên nền sáng (AA) */\r\n  /* Surfaces */\r\n  --bg: #f7f8fc;\r\n  --sidebar: #ffffff;\r\n  --surface: #ffffff;\r\n  --surface-2: #f8fafc;         /* secondary surface, hàng bảng */\r\n  --surface-hover: #f1f5f9;\r\n  --row: #f8fafc;\r\n  --row-hover: #f1f5fb;\r\n  --selected: #eff6ff;\r\n  /* Lines */\r\n  --border: #e5eaf1;\r\n  --border-strong: #d5dde8;\r\n  /* Text */\r\n  --text: #111827;\r\n  --text-2: #475569;\r\n  --text-3: #5a6a80;            /* chữ phụ cỡ nhỏ — AA trên trắng & nền xanh nhạt */\r\n  --text-muted: #94a3b8;        /* placeholder, icon, trang trí */\r\n  --text-disabled: #a6b2c3;\r\n  /* Semantic */\r\n  --focus: #2563eb;\r\n  --focus-ring: rgba(37, 99, 235, 0.22);\r\n  --success: #16a34a;\r\n  --success-text: #15803d;\r\n  --success-soft: #dcfce7;\r\n  --warning: #d97706;\r\n  --warning-text: #b45309;\r\n  --warning-soft: #fef3c7;\r\n  --danger: #dc2626;\r\n  --danger-hover: #b91c1c;\r\n  --danger-text: #b91c1c;\r\n  --danger-soft: #fee2e2;\r\n  --info: #2563eb;\r\n  --info-text: #1d4ed8;\r\n  --info-soft: #dbeafe;\r\n  --neutral: #94a3b8;\r\n  --neutral-soft: #f1f5f9;\r\n  /* Chart (đã chạy validator dataviz) */\r\n  --chart-1: #2563eb;\r\n  --chart-2: #0ea5a4;\r\n  --chart-grid: #edf1f6;\r\n  /* Elevation */\r\n  --shadow-card: 0 1px 2px rgba(15, 23, 42, 0.04);\r\n  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);\r\n  --shadow-pop: 0 12px 32px rgba(15, 23, 42, 0.12), 0 2px 6px rgba(15, 23, 42, 0.06);\r\n  --overlay: rgba(15, 23, 42, 0.42);\r\n  /* Shape */\r\n  --r-xs: 6px;\r\n  --r-sm: 8px;\r\n  --r: 10px;\r\n  --r-lg: 14px;\r\n  --r-full: 999px;\r\n  /* Type */\r\n  --font: \"Inter\", \"Be Vietnam Pro\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\r\n  --ease: cubic-bezier(0.2, 0, 0, 1);\r\n  --t: 160ms;\r\n  color-scheme: light;\r\n}\r\n\r\n/* ── Tokens: Dark ──────────────────────────────────── */\r\nhtml[data-theme=\"dark\"] .cr {\r\n  --primary: #60a5fa;\r\n  --primary-hover: #93c5fd;\r\n  --primary-active: #bfdbfe;\r\n  --primary-soft: #1e3a5f;\r\n  --primary-subtle: #172a46;\r\n  --primary-fg: #0b1220;\r\n  --primary-text: #93c5fd;\r\n  --bg: #0f172a;\r\n  --sidebar: #111827;\r\n  --surface: #1e293b;\r\n  --surface-2: #273449;\r\n  --surface-hover: #2c3a52;\r\n  --row: #243146;\r\n  --row-hover: #2b3a54;\r\n  --selected: #1e3a5f;\r\n  --border: #334155;\r\n  --border-strong: #475569;\r\n  --text: #f8fafc;\r\n  --text-2: #cbd5e1;\r\n  --text-3: #a3b1c6;\r\n  --text-muted: #94a3b8;\r\n  --text-disabled: #64748b;\r\n  --focus: #60a5fa;\r\n  --focus-ring: rgba(96, 165, 250, 0.3);\r\n  --success: #4ade80;\r\n  --success-text: #86efac;\r\n  --success-soft: rgba(74, 222, 128, 0.14);\r\n  --warning: #fbbf24;\r\n  --warning-text: #fcd34d;\r\n  --warning-soft: rgba(251, 191, 36, 0.14);\r\n  --danger: #f87171;\r\n  --danger-hover: #fca5a5;\r\n  --danger-text: #fca5a5;\r\n  --danger-soft: rgba(248, 113, 113, 0.14);\r\n  --info: #60a5fa;\r\n  --info-text: #93c5fd;\r\n  --info-soft: rgba(96, 165, 250, 0.16);\r\n  --neutral: #64748b;\r\n  --neutral-soft: #273449;\r\n  --chart-1: #5a8ff0;\r\n  --chart-2: #14a3a1;\r\n  --chart-grid: #2b3850;\r\n  --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.25);\r\n  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);\r\n  --shadow-pop: 0 16px 40px rgba(0, 0, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.3);\r\n  --overlay: rgba(2, 6, 23, 0.62);\r\n  color-scheme: dark;\r\n}\r\n\r\n/* ── Base ──────────────────────────────────────────── */\r\n.cr {\r\n  min-height: 100vh;\r\n  display: grid;\r\n  grid-template-columns: 252px minmax(0, 1fr);\r\n  background: var(--bg);\r\n  color: var(--text);\r\n  font-family: var(--font);\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  font-feature-settings: \"cv11\", \"ss01\";\r\n  -webkit-font-smoothing: antialiased;\r\n}\r\n.cr.collapsed { grid-template-columns: 76px minmax(0, 1fr); }\r\n.cr *, .cr *::before, .cr *::after { box-sizing: border-box; }\r\n.cr ::selection { background: var(--primary-soft); color: var(--text); }\r\n.cr :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }\r\n.cr h1, .cr h2, .cr h3 { color: var(--text); letter-spacing: -0.012em; }\r\n.cr p { color: inherit; }\r\n.cr a { color: inherit; text-decoration: none; }\r\n.cr button { font-family: inherit; }\r\n.cr-num, .cr-mono { font-variant-numeric: tabular-nums; }\r\n.cr-muted { color: var(--text-2); }\r\n.cr-subtle { color: var(--text-3); }\r\n.cr .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\r\n.cr kbd { font-family: var(--font); font-size: 11px; font-weight: 500; color: var(--text-3); background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--r-xs); padding: 1px 6px; line-height: 16px; }\r\n\r\n/* ── Sidebar ───────────────────────────────────────── */\r\n.cr-side {\r\n  position: sticky; top: 0; height: 100vh; overflow-y: auto; overflow-x: hidden;\r\n  background: var(--sidebar); border-right: 1px solid var(--border);\r\n  display: flex; flex-direction: column; padding: 0 14px 16px;\r\n  scrollbar-width: thin;\r\n}\r\n.cr-brand { display: flex; align-items: center; gap: 11px; padding: 0 6px; min-height: 76px; border-bottom: 1px solid var(--border); margin: 0 -14px 14px; padding-left: 20px; }\r\n.cr-brand-mark {\r\n  width: 34px; height: 34px; border-radius: 10px; flex: none; display: grid; place-items: center;\r\n  background: var(--primary); color: var(--primary-fg);\r\n}\r\n.cr-brand-name { font-weight: 700; font-size: 17px; letter-spacing: -0.02em; white-space: nowrap; line-height: 1.15; color: var(--text); }\r\n.cr-brand-name small { display: block; font-weight: 500; font-size: 12px; color: var(--text-3); letter-spacing: 0; }\r\n.cr-nav { display: flex; flex-direction: column; gap: 2px; }\r\n.cr-nav-title { color: var(--text-3); font-size: 12px; font-weight: 500; padding: 16px 12px 6px; white-space: nowrap; }\r\n.cr-nav a {\r\n  position: relative; display: flex; align-items: center; gap: 12px; height: 42px; padding: 0 12px; border-radius: var(--r);\r\n  color: var(--text-2); font-weight: 500; font-size: 14px; white-space: nowrap;\r\n  transition: background var(--t) var(--ease), color var(--t) var(--ease);\r\n}\r\n.cr-nav a svg { flex: none; color: var(--text-muted); transition: color var(--t) var(--ease); }\r\n.cr-nav a:hover { background: var(--surface-hover); color: var(--text); }\r\n.cr-nav a:hover svg { color: var(--text-2); }\r\n.cr-nav a.active { background: var(--primary-soft); color: var(--primary-text); font-weight: 600; }\r\n.cr-nav a.active svg { color: var(--primary); }\r\n.cr-nav a.active::before { content: \"\"; position: absolute; left: -14px; top: 9px; bottom: 9px; width: 3px; border-radius: 0 3px 3px 0; background: var(--primary); }\r\n.cr-side-foot { margin-top: auto; padding-top: 16px; display: grid; gap: 2px; }\r\n.cr-side-link {\r\n  display: flex; align-items: center; gap: 12px; height: 40px; padding: 0 12px; border: 0; background: none; width: 100%;\r\n  color: var(--text-2); border-radius: var(--r); cursor: pointer; font-size: 14px; font-weight: 500; white-space: nowrap; text-align: left;\r\n  transition: background var(--t) var(--ease), color var(--t) var(--ease);\r\n}\r\n.cr-side-link svg { color: var(--text-muted); flex: none; }\r\n.cr-side-link:hover { background: var(--surface-hover); color: var(--text); }\r\n.cr-side-link.active { background: var(--primary-soft); color: var(--primary-text); }\r\n.cr-side-link.active svg { color: var(--primary); }\r\n.cr-side-link.logout { background: var(--surface-2); color: var(--text); }\r\n.cr-side-link.logout:hover { color: var(--danger-text); }\r\n.cr-side-link.logout:hover svg { color: var(--danger); }\r\n.cr-side-link:disabled { opacity: 0.6; cursor: progress; }\r\n\r\n/* Thẻ \"Hôm nay\" cuối sidebar — dữ liệu thật từ lịch & hàng chờ duyệt */\r\n.cr-today {\r\n  margin-top: 12px; padding: 14px; border-radius: var(--r-lg); background: var(--primary-subtle);\r\n  border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent); display: grid; gap: 10px;\r\n}\r\n.cr-today-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }\r\n.cr-today-head small { color: var(--text-3); font-size: 12px; font-weight: 500; }\r\n.cr-today-head span { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: var(--surface); color: var(--primary); box-shadow: var(--shadow-sm); }\r\n.cr-today strong { font-size: 15px; font-weight: 600; color: var(--text); display: block; line-height: 1.3; }\r\n.cr-today-stats { display: grid; gap: 4px; font-size: 13px; color: var(--text-2); }\r\n.cr-today-stats b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }\r\n.cr-today .cr-btn { width: 100%; background: var(--surface); }\r\n\r\n.cr.collapsed .cr-side { padding: 0 12px 16px; }\r\n.cr.collapsed .cr-brand { justify-content: center; padding-left: 0; margin: 0 -12px 14px; }\r\n.cr.collapsed .cr-nav-title { visibility: hidden; height: 14px; padding: 0; }\r\n.cr.collapsed .cr-nav a span, .cr.collapsed .cr-brand-name, .cr.collapsed .cr-side-link span, .cr.collapsed .cr-today { display: none; }\r\n.cr.collapsed .cr-nav a, .cr.collapsed .cr-side-link { justify-c